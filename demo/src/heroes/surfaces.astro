---
/** The gallery's surfaces, a hero each, in the order they are shown. */
import Hero from '../components/Hero.astro';
import RadiantGlass from '@arraypress/effects-astro/RadiantGlass.astro';
import Glass from '@arraypress/effects-astro/Glass.astro';
import BorderSweep from '@arraypress/effects-astro/BorderSweep.astro';
import Tilt from '@arraypress/effects-astro/Tilt.astro';
import Parallax from '@arraypress/effects-astro/Parallax.astro';
import Magnetic from '@arraypress/effects-astro/Magnetic.astro';
import Cursor from '@arraypress/effects-astro/Cursor.astro';
import PulseMark from '@arraypress/effects-astro/PulseMark.astro';
import '@arraypress/effects-astro/motion.css';
import MosaicReveal from '@arraypress/effects-astro/MosaicReveal.astro';
import '../styles/product-stack.css';
import ProductStack from '@arraypress/effects-astro/ProductStack.astro';
import { COVERS } from '../gallery';
import ImageRipple from '@arraypress/effects-astro/ImageRipple.astro';
---

<Hero id="radiant-glass" name="RadiantGlass" code="<RadiantGlass />" align="right" style="--hero-ground: #060818">
	<RadiantGlass slot="effect" />
	<span class="eyebrow">Solace · smart lighting</span>
	<h2 class="headline" style="max-width: 10ch; margin-left: auto">Every room, <em>lit by feel.</em></h2>
	<p class="lede" style="max-width: 26rem">Lamps that learn how you live: bright for the work, low for the film, and amber for the slow end of the evening.</p>
	<div class="actions"><a class="btn" href="#">Shop the starter kit</a><a class="btn btn--ghost" href="#">See it after dark</a></div>
</Hero>
<Hero id="glass" name="Glass" code="<Glass>…</Glass>" style="--hero-ground: radial-gradient(70% 60% at 25% 30%, #0e7490, transparent 70%), radial-gradient(60% 60% at 80% 70%, #ea580c, transparent 70%), #0b0b10">
	<div class="row">
		{[['Solo', '£0', 'One calendar, unlimited bookings.'], ['Studio', '£12', 'Team calendars and deposits.'], ['Clinic', '£39', 'Rooms, staff and reminders.']].map(([plan, price, text]) => (
			<Glass style="width: 240px; padding: 28px; border-radius: 20px; text-align: left"><strong style="font-size: 20px">{plan}</strong><p style="color: #d4d4d8; font-size: 14px">{text}</p><b style="font-size: 40px; letter-spacing: -0.03em">{price}</b></Glass>
		))}
	</div>
</Hero>
<Hero id="liquid-glass" name="Glass · refract" code={`<Glass refract>…</Glass>`} style="--hero-ground: linear-gradient(rgb(6 8 14 / 0.25), rgb(6 8 14 / 0.55)), url(/photos/rain-on-glass-1.jpg) center 45% / cover, #0a0d12">
	<div style="position: relative; display: grid; place-items: center; width: min(1100px, 88vw); min-height: 520px">
		<p style="position: absolute; inset: 50% 0 auto; translate: 0 -54%; margin: 0; font-size: clamp(96px, 17vw, 240px); font-weight: 800; line-height: 0.86; letter-spacing: -0.055em; text-transform: uppercase; color: #ff7a45">After<br />dark</p>
		<div class="row">
			<Glass refract style="width: 340px; padding: 30px 32px; border-radius: 30px; text-align: left">
				<span style="font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: #fde68a">Lantern Row · night walks</span>
				<strong style="display: block; margin: 10px 0 8px; font-size: 26px; line-height: 1.15; letter-spacing: -0.02em">Six streets, four kitchens, one umbrella each.</strong>
				<p style="margin: 0 0 18px; color: #e4e4e7; font-size: 15px; line-height: 1.5">A slow walk through the old quarter after the rain, with a guide who knows which stall is worth the queue.</p>
				<a href="#routes" style="color: #fff; font-weight: 600">See the routes →</a>
			</Glass>
			<div style="display: grid; gap: 22px; justify-items: center">
				<Glass refract amount={14} dispersion={0.6} style="width: 200px; height: 200px; border-radius: 50%; display: grid; place-content: center; text-align: center">
					<b style="font-size: 54px; line-height: 1; letter-spacing: -0.04em">19:30</b>
					<span style="margin-top: 6px; color: #e4e4e7; font-size: 14px">tonight · 12 places</span>
				</Glass>
				<Glass as="a" href="#book" refract amount={14} bezel={16} style="display: inline-flex; align-items: center; height: 56px; padding: 0 30px; border-radius: 999px; color: #fff; font-size: 17px; font-weight: 600; text-decoration: none">Book a walk</Glass>
			</div>
		</div>
	</div>
</Hero>
<Hero id="border-sweep" name="BorderSweep" code={`<BorderSweep color="#22d3ee" always>…</BorderSweep>`}>
	<div class="row">
		<BorderSweep color="var(--hero-accent)" style="width: 300px; padding: 32px; border-radius: 18px; border: 1px solid #27272a; text-align: left"><strong style="font-size: 22px">Hover me</strong><p style="color: #a1a1aa">The light runs round on hover and focus.</p></BorderSweep>
		<BorderSweep color="var(--hero-accent)" always style="width: 300px; padding: 32px; border-radius: 18px; border: 1px solid #27272a; text-align: left"><strong style="font-size: 22px">Featured</strong><p style="color: #a1a1aa">Or all the time, for the plan you want picked.</p></BorderSweep>
	</div>
</Hero>
<Hero id="tilt" name="Tilt" code={`<Tilt glare max={12} lift={10}>…</Tilt>`}>
	<div class="row">
		{['#7c3aed', '#db2777', '#0891b2'].map((c, i) => (
			<Tilt glare max={12} lift={10} style={`width: 220px; height: 300px; border-radius: 18px; display: flex; align-items: flex-end; padding: 20px; box-sizing: border-box; font-weight: 600; font-size: 20px; background: linear-gradient(160deg, ${c}, #18181b)`}>Vol. {i + 1}</Tilt>
		))}
	</div>
</Hero>
<Hero id="parallax" name="Parallax" code={`<Parallax depth={60}>…</Parallax>`}>
	<div data-parallax-root style="position: absolute; inset: 0; z-index: -1">
		<Parallax depth={-30} style="position: absolute; inset: 0; display: grid; place-items: center"><div style="width: 420px; height: 420px; border-radius: 50%; background: #0f766e; translate: -220px -40px"></div></Parallax>
		<Parallax depth={60} style="position: absolute; inset: 0; display: grid; place-items: center"><div style="width: 200px; height: 200px; border-radius: 50%; background: #f59e0b; translate: 240px 80px"></div></Parallax>
		<Parallax depth={100} style="position: absolute; inset: 0; display: grid; place-items: center"><div style="width: 80px; height: 80px; border-radius: 50%; background: #f472b6; translate: 60px -170px"></div></Parallax>
	</div>
	<span class="eyebrow">Wanderlight · weekend trips</span>
	<h2 class="headline">Somewhere new,<br /><em>every weekend.</em></h2>
</Hero>
<Hero id="magnetic" name="Magnetic" code={`<Magnetic as="a" href="/call" class="btn">Book a call</Magnetic>`}>
	<span class="eyebrow">Ledgerly · bookkeeping</span>
	<h2 class="headline">Your books, done by Friday.</h2>
	<div class="actions" style="margin-top: 40px">
		<Magnetic as="a" href="#" class="btn" style="height: 58px; padding: 0 34px; font-size: 18px">Book a call</Magnetic>
		<Magnetic as="a" href="#" class="btn btn--ghost" strength={0.45} style="height: 58px; padding: 0 34px; font-size: 18px">See pricing</Magnetic>
	</div>
</Hero>
<Hero id="cursor" name="Cursor" code={`<Cursor blend="difference" />`}>
	<template data-cursor-template><Cursor blend="difference" /></template>
	<div data-cursor-slot></div>
	<h2 class="headline">A softer pointer.</h2>
	<div class="actions"><button type="button" class="btn" data-cursor-toggle>Try the custom cursor</button><a class="btn btn--ghost" href="#" data-cursor="View">A link with a label</a></div>
</Hero>
<Hero id="pulse-mark" name="PulseMark · motion.css" code={`<PulseMark variant="sonar" size={120} color="#00ff88" glow />  ·  <span class="fx-live"></span>`}>
	<div class="row" style="gap: 72px">
		<PulseMark variant="matrix" size={120} color="#f59e0b" glow />
		<PulseMark variant="rings" size={120} />
		<PulseMark variant="sonar" size={120} color="#00ff88" glow />
		<span style="display: inline-flex; align-items: center; gap: 12px; font-size: 22px"><span class="fx-live"></span>Available for work</span>
	</div>
</Hero>
<Hero id="mosaic-reveal" name="MosaicReveal" code={`<MosaicReveal images={[{ src: '/photos/mosaic-reveal-1.jpg', alt: 'Glazed stoneware bottles in sage, celadon and slate' }, { src: '/photos/mosaic-reveal-2.jpg', alt: 'Terracotta and sky-blue vases on a pale table' }, { src: '/photos/mosaic-reveal-3.jpg', alt: 'Hands raising a pot on the wheel' }, { src: '/photos/mosaic-reveal-4.jpg', alt: 'Bisque bowls drying on wooden shelves' }]} />`} align="left" style="--hero-ground: #0c0b0a; --mosaic-reveal-dots-bottom: 108px">
	<MosaicReveal slot="effect" images={[{ src: '/photos/mosaic-reveal-1.jpg', alt: 'Glazed stoneware bottles in sage, celadon and slate' }, { src: '/photos/mosaic-reveal-2.jpg', alt: 'Terracotta and sky-blue vases on a pale table' }, { src: '/photos/mosaic-reveal-3.jpg', alt: 'Hands raising a pot on the wheel' }, { src: '/photos/mosaic-reveal-4.jpg', alt: 'Bisque bowls drying on wooden shelves' }]} />
	<span aria-hidden="true" style="position: absolute; top: -100vh; bottom: -100vh; left: -6vw; width: min(64vw, 820px); z-index: -1; background: linear-gradient(90deg, rgb(12 11 10 / 0.86), rgb(12 11 10 / 0.6) 55%, transparent); pointer-events: none"></span>
	<span class="eyebrow">Oxbow Clay · stoneware studio</span>
	<h2 class="headline" style="max-width: 9ch">Thrown slow, <em>fired hot.</em></h2>
	<p class="lede" style="max-width: 25rem">Small batches from a riverside studio: glazes mixed by hand, every piece fired twice and finished at the wheel it was made on.</p>
	<div class="actions"><a class="btn" href="#">Shop the spring firing</a><a class="btn btn--ghost" href="#">Book a studio visit</a></div>
</Hero>
<Hero id="product-stack" name="ProductStack" code={`<ProductStack items={covers} size="360px" />`} align="right" style="--hero-ground: radial-gradient(55% 70% at 27% 52%, #2a1d17, transparent 70%), #0d0b0a">
	<div slot="effect" class="stack-side">
		<ProductStack items={COVERS} size="360px" />
	</div>
	<div class="stack-copy">
		<span class="eyebrow">Loamworks · digital goods</span>
		<h2 class="headline">Tools for the<br /><em>things you make.</em></h2>
		<p class="lede">Sample packs, synth presets, typefaces and templates from forty independent studios. Pay once, download straight away, and use them in everything you release.</p>
		<div class="actions"><a class="btn" href="#">Browse the shop</a><a class="btn btn--ghost" href="#">New this week</a></div>
	</div>
</Hero>
<Hero id="image-ripple" name="ImageRipple" code={`<ImageRipple src="/photos/image-ripple-1.jpg" alt="Bare trees in morning mist, mirrored in a still river" />`} theme="light" align="left" style="--hero-ground: #d9d3c7; --muted: #3f3b35">
	<ImageRipple slot="effect" src="/photos/image-ripple-1.jpg" alt="Bare trees in morning mist, mirrored in a still river" />
	<span aria-hidden="true" style="position: absolute; inset: -30% -45% -30% -25%; z-index: -1; background: radial-gradient(closest-side, rgb(240 235 226 / 0.7), rgb(240 235 226 / 0.35) 55%, transparent); pointer-events: none"></span>
	<span class="eyebrow">Stillwater · landscape prints</span>
	<h2 class="headline" style="max-width: 8ch">Wait for the <em>still.</em></h2>
	<p class="lede" style="max-width: 25rem">Lakes and rivers at first light, printed on cotton rag and signed by hand. Touch the water; it settles.</p>
	<div class="actions"><a class="btn" href="#">Browse the prints</a><a class="btn btn--ghost" href="#">Dawn workshops</a></div>
	<div style="display: flex; gap: 14px; margin-top: 40px">
		<a href="#" style="display: grid; gap: 6px; color: inherit; font-size: 12px; text-decoration: none"><img src="/photos/image-ripple-2.jpg" alt="Autumn trees mirrored in a misty lake at sunrise" width="132" height="88" style="border-radius: 6px; object-fit: cover" />No. 14 · First frost</a>
		<a href="#" style="display: grid; gap: 6px; color: inherit; font-size: 12px; text-decoration: none"><img src="/photos/image-ripple-3.jpg" alt="Pines above a band of fog on a glacial lake" width="132" height="88" style="border-radius: 6px; object-fit: cover" />No. 09 · Glacier water</a>
	</div>
</Hero>
