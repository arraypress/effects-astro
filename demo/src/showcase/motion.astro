---
import '@arraypress/effects-astro/motion.css';
---

<section class="stage"><div class="row">
	<div><span class="ring fx-pulse-ring">▶</span><p>.fx-pulse-ring</p></div>
	<div><span class="heart fx-heartbeat is-active">♥</span><p>.fx-heartbeat</p></div>
	<div><span class="fx-wiggle big">✦</span><p>.fx-wiggle</p></div>
	<div><span class="fx-live dot"></span><p>.fx-live</p></div>
	<div><button id="bump" class="badge fx-bump">3</button><p>.fx-bump (click)</p></div>
</div></section>
<script>
	import { bump } from '@arraypress/effects-astro';
	const badge = document.getElementById('bump') as HTMLElement;
	badge.addEventListener('click', () => {
		badge.textContent = String(Number(badge.textContent) + 1);
		bump(badge);
	});
</script>

<style>
.row { display: flex; gap: 72px; align-items: end; text-align: center; zoom: 1.7; }
p { color: #71717a; font: 12px ui-monospace, monospace; margin: 18px 0 0; }
.ring { width: 56px; height: 56px; border-radius: 50%; display: inline-grid; place-items: center; background: #a78bfa; color: #000; --fx-color: #a78bfa; }
.heart { display: inline-block; font-size: 52px; color: #f43f5e; }
.big { display: inline-block; font-size: 48px; }
.dot { font-size: 28px; }
.badge { width: 56px; height: 56px; border-radius: 50%; border: 0; background: #fafafa; font-weight: 700; font-size: 20px; cursor: pointer; }
</style>
