---
import Skeleton from '@arraypress/effects-astro/Skeleton.astro';
---

<section class="stage"><div class="row"><div class="col"><Skeleton variant="card" /></div><div class="col"><Skeleton variant="row" /><Skeleton variant="row" /><Skeleton lines={4} /></div></div></section>

<style>
.row { display: grid; grid-template-columns: 360px 480px; gap: 40px; }
.col { display: grid; gap: 16px; align-content: start; }
</style>
