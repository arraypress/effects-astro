---
import Grain from '@arraypress/effects-astro/Grain.astro';
---

<section class="stage"><Grain opacity={0.35} /><div><h1 class="headline">Film grain.</h1><p class="lede">Over a smooth gradient, so it never bands.</p></div></section>

<style>
section { background: radial-gradient(120% 90% at 30% 20%, #7c3aed, #1e1b4b 55%, #09090b); }
</style>
