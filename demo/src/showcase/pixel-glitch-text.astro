---
import PixelGlitchText from '@arraypress/effects-astro/PixelGlitchText.astro';
---

<section class="stage"><div class="wrap"><p>Move over the word</p><PixelGlitchText as="div" class="wm" fit stroke={1.5}>Northwave</PixelGlitchText></div></section>

<style>
.wrap { width: 100%; padding: 0 3vw; box-sizing: border-box; }
.wm { font-weight: 800; letter-spacing: -0.05em; line-height: 0.85; }
p { margin: 0 0 1rem; color: #71717a; font: 13px ui-monospace, monospace; text-align: center; }
</style>
