---
import ScrollProgress from '@arraypress/effects-astro/ScrollProgress.astro';
---

<ScrollProgress color="#a78bfa" />
<main><h1 class="headline">Scroll, and watch the top.</h1>{Array.from({ length: 8 }, () => <p>FlareCart sells digital files: a Worker on your own Cloudflare account, Stripe Checkout, R2 downloads and licence keys. Your store, your data, no monthly fee to anyone but the platforms you already use.</p>)}</main>

<style>
main { max-width: 640px; margin: 0 auto; padding: 22vh 24px 30vh; }
h1 { margin-bottom: 3rem !important; }
p { color: #a1a1aa; font-size: 19px; line-height: 1.8; margin: 0 0 2rem; }
</style>
