---
import FlutedGlass from '@arraypress/effects-astro/FlutedGlass.astro';
---

<section class="stage"><FlutedGlass /><h1>Brands seen<br />through <em>a different light.</em></h1></section>

<style>
h1 { position: absolute !important; left: 48px; bottom: 60px; margin: 0; font-size: clamp(44px, 6.6vw, 84px); line-height: 1; letter-spacing: -0.03em; font-weight: 500; }
em { font-family: Georgia, serif; color: #4338ca; }
</style>
