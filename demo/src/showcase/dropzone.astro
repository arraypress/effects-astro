---
import Dropzone from '@arraypress/effects-astro/Dropzone.astro';
---

<section class="stage"><div class="wrap">
	<Dropzone id="zone" accept=".csv,.pdf" color="#f43f5e" label="Upload a bank statement">
		<div><h2>Drop your bank statement</h2><p>CSV or PDF, or click to choose</p></div>
		<div slot="busy"><h2>Scanning <span id="file"></span></h2><p>Matching against 214 known patterns</p></div>
	</Dropzone>
	<Dropzone busy color="#22d3ee"><div /><div slot="busy"><h2>Busy</h2><p>The scanning state</p></div></Dropzone>
</div></section>
<script>
	const zone = document.getElementById('zone') as HTMLElement;
	zone.addEventListener('change', (e) => {
		(document.getElementById('file') as HTMLElement).textContent = (e.target as HTMLInputElement).files?.[0]?.name ?? '';
		zone.dataset.busy = '';
		setTimeout(() => delete zone.dataset.busy, 3000);
	});
</script>

<style>
.wrap { width: 100%; max-width: 620px; padding: 0 24px; display: grid; gap: 24px; }
h2 { margin: 0 0 4px; font-size: 16px; }
p { margin: 0; color: #71717a; font-size: 13px; }
</style>
