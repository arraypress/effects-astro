---
import VinylSleeve from '@arraypress/effects-astro/VinylSleeve.astro';
const cover = 'data:image/svg+xml,' + encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 10 10"><defs><linearGradient id="g" x2="1" y2="1"><stop stop-color="#7c3aed"/><stop offset="1" stop-color="#06b6d4"/></linearGradient></defs><rect width="10" height="10" fill="url(#g)"/></svg>');
const cover2 = 'data:image/svg+xml,' + encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 10 10"><defs><linearGradient id="g" x2="1" y2="1"><stop stop-color="#f59e0b"/><stop offset="1" stop-color="#db2777"/></linearGradient></defs><rect width="10" height="10" fill="url(#g)"/></svg>');
---

<section class="stage"><div class="row"><div><VinylSleeve cover={cover} /><p>hover</p></div><div><VinylSleeve cover={cover2} playing /><p>playing</p></div></div></section>

<style>
.row { display: flex; gap: 140px; }
.row :global(.effect-vinyl) { width: 360px; }
p { margin: 24px 0 0; color: #71717a; font: 13px ui-monospace, monospace; text-align: center; }
</style>
