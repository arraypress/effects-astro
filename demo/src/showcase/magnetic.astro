---
import Magnetic from '@arraypress/effects-astro/Magnetic.astro';
---

<section class="stage"><div class="row">
	<Magnetic as="a" href="#" class="btn">Start selling</Magnetic>
	<Magnetic as="a" href="#" class="btn ghost" strength={0.45}>See the demo</Magnetic>
</div></section>

<style>
.row { display: flex; gap: 36px; }
.row :global(.btn) { padding: 26px 44px; border-radius: 999px; background: #fafafa; color: #09090b; font-weight: 600; font-size: 24px; text-decoration: none; }
.row :global(.ghost) { background: none; color: #fafafa; border: 1px solid #3f3f46; }
</style>
