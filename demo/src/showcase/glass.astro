---
import Glass from '@arraypress/effects-astro/Glass.astro';
import LightField from '@arraypress/effects-astro/LightField.astro';
---

<LightField fixed colors={['#7c3aed', '#db2777', '#06b6d4']} fluid={false} />
<section class="stage"><div class="cards">
	<Glass class="card"><h3>Starter</h3><p>One store, every feature.</p><b>£0</b></Glass>
	<Glass class="card"><h3>Studio</h3><p>Licences, bundles, analytics.</p><b>£12</b></Glass>
	<Glass class="card"><h3>Label</h3><p>Many artists, one dashboard.</p><b>£39</b></Glass>
</div></section>

<style>
.cards { display: grid; grid-template-columns: repeat(3, minmax(0, 240px)); gap: 20px; }
.cards :global(.card) { padding: 28px; border-radius: 20px; }
h3 { margin: 0; font-size: 20px; }
p { color: #d4d4d8; font-size: 14px; }
b { font-size: 40px; letter-spacing: -0.03em; }
</style>
