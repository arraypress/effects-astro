---
import '@arraypress/effects-astro/tooltip.css';
---

<section class="stage"><div class="pills">
	<span class="pill" tabindex="0" data-tip="Sell licence keys with every download" id="first">Licence keys</span>
	<span class="pill" tabindex="0" data-tip="Shown below, this time" data-tip-side="bottom">Below</span>
	<span class="pill" tabindex="0" data-tip="Any colours you like" style="--tip-bg: #18181b; --tip-color: #fff; --tip-border: #ff6b6b">Bordered</span>
</div></section>

<style>
.pills { display: flex; gap: 14px; }
.pills { zoom: 1.6; margin-top: 60px; }
.pill { padding: 16px 28px; border: 1px solid #3f3f46; border-radius: 99px; }
.pills { gap: 22px !important; }
</style>

<script>
	// Show the first tooltip straight away, so it is clear what the page is.
	(document.getElementById('first') as HTMLElement).focus({ focusVisible: true } as FocusOptions);
</script>
