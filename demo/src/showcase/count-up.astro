---
import CountUp from '@arraypress/effects-astro/CountUp.astro';
---

<section class="stage"><div class="stats">
	<div><b><CountUp value={12840} /></b><span>stores</span></div>
	<div><b><CountUp value={2400000} currency="GBP" compact /></b><span>paid out</span></div>
	<div><b><CountUp value={99.98} decimals={2} />%</b><span>uptime</span></div>
</div></section>

<style>
.stats { display: flex; flex-wrap: wrap; justify-content: center; gap: 4rem; text-align: center; }
b { display: block; font-size: clamp(56px, 9vw, 128px); letter-spacing: -0.04em; }
span { color: #71717a; }
</style>
