---
import ScrollReveal from '@arraypress/effects-astro/ScrollReveal.astro';
---

<ScrollReveal />
<main>
	<h1 class="headline fade-in-up">Scroll down.</h1>
	{['fade-in-up', 'fade-in-left', 'slide-in-up', 'zoom-in', 'flip-up', 'blur-in', 'fade-in-right', 'zoom-out', 'flip-left', 'slide-in-right'].map((kind, i) => <div class={`card ${kind}`} style={`--reveal-delay: ${(i % 2) * 0.08}s`}>.{kind}</div>)}
</main>

<style>
main { max-width: 900px; margin: 0 auto; padding: 20vh 24px 40vh; display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
h1 { grid-column: 1 / -1; margin-bottom: 18vh !important; }
.card { height: 220px; border-radius: 16px; background: linear-gradient(160deg, #7c3aed, #18181b); display: grid; place-items: center; font: 600 18px ui-monospace, monospace; }
</style>
