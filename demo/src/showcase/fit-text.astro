---
import FitText from '@arraypress/effects-astro/FitText.astro';
---

<section class="stage"><div class="wrap"><FitText as="h1">Make it fit.</FitText><FitText as="p">Any words, edge to edge, at any width</FitText></div></section>

<style>
.wrap { width: 100%; padding: 0 4vw; box-sizing: border-box; }
h1 { margin: 0; font-weight: 800; letter-spacing: -0.05em; line-height: 0.9; }
p { margin: 1rem 0 0; color: #71717a; font-family: ui-monospace, monospace; }
</style>
