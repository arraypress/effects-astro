---
import BorderSweep from '@arraypress/effects-astro/BorderSweep.astro';
---

<section class="stage"><div class="cards">
	<BorderSweep class="card" color="#a78bfa"><h3>Hover me</h3><p>The light runs round on hover and focus.</p></BorderSweep>
	<BorderSweep class="card" color="#22d3ee" always><h3>Featured</h3><p>Or all the time, for the plan you want picked.</p></BorderSweep>
	<BorderSweep as="a" href="#" class="pill" color="#f472b6" always>Ghost button →</BorderSweep>
</div></section>

<style>
.cards { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 24px; }
.cards :global(.card) { width: 340px; padding: 36px; border-radius: 18px; border: 1px solid #27272a; }
.cards :global(.pill) { padding: 20px 34px; font-size: 20px; border-radius: 999px; border: 1px solid #27272a; color: inherit; text-decoration: none; }
h3 { margin: 0; font-size: 26px; }
p { color: #a1a1aa; font-size: 17px; margin-bottom: 0; }
</style>
