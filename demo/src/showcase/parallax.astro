---
import Parallax from '@arraypress/effects-astro/Parallax.astro';
---

<section class="stage" data-parallax-root>
	<Parallax depth={-30} class="layer"><div class="blob a"></div></Parallax>
	<Parallax depth={50} class="layer"><div class="blob b"></div></Parallax>
	<Parallax depth={90} class="layer"><div class="blob c"></div></Parallax>
	<h1 class="headline">Depth, by pointer.</h1>
</section>

<style>
.stage :global(.layer) { position: absolute !important; inset: 0; display: grid; place-items: center; pointer-events: none; }
.blob { border-radius: 50%; filter: blur(2px); }
.a { width: 420px; height: 420px; background: #312e81; translate: -180px -60px; }
.b { width: 220px; height: 220px; background: #7c3aed; translate: 220px 80px; }
.c { width: 90px; height: 90px; background: #f472b6; translate: 60px -170px; }
</style>
