---
/**
 * The gallery's page: the bar across the top (filters by type, the arrows
 * through the heroes in the filter, and the "All effects" overview), every
 * group's heroes, one on show at a time, and the customise panel.
 */
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/gallery.css';
import '../styles/bar.css';
import Panel from '../components/Panel.astro';
import Overview from '../components/Overview.astro';
import { GROUPS } from '../tour/groups';
import { collect } from '../tour/stops';

const tours = await collect();
const total = tours.reduce((sum, tour) => sum + tour.stops.length, 0);
---

<html lang="en-GB">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>effects-astro</title>
		<link rel="icon" href="data:," />
	</head>
	<body>
		<nav class="bar" aria-label="Gallery">
			<a class="bar__brand" href="/">effects-astro</a>
			<div class="bar__filters" aria-label="Show">
				<a href="/" data-filter="">All</a>
				{GROUPS.map((group) => <a href={`/?type=${group.type}`} data-filter={group.type}>{group.name}</a>)}
			</div>
			<div class="bar__step">
				<a class="bar__arrow" href="/" aria-label="Previous effect" data-step="-1">
					<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M10 3.5L5.5 8l4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
				</a>
				<span class="bar__count" aria-live="polite"><b data-count>1</b> / <span data-total>{total}</span><span class="bar__group"> · <span data-count-group>{GROUPS[0].name}</span></span></span>
				<a class="bar__arrow" href="/" aria-label="Next effect" data-step="1">
					<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M6 3.5L10.5 8 6 12.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
				</a>
			</div>
			<button type="button" class="bar__all" aria-controls="overview" aria-expanded="false" data-overview-open>
				<svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true"><path d="M2.5 2.5h4v4h-4zm7 0h4v4h-4zm-7 7h4v4h-4zm7 0h4v4h-4z" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"></path></svg>
				<span>All effects</span>
			</button>
		</nav>
		<slot />
		<Panel />
		<Overview groups={tours} />
		<script>
			import '../scripts/gallery.js';
			import '../scripts/bar.js';
			import '../scripts/overview.js';
			import '../scripts/keys.js';
			import { start } from '../scripts/viewer.js';
			start();
		</script>
	</body>
</html>
