---
/** One effect's page: a full-screen stage on a dark or light ground, and a pill back to the gallery. */
import '../styles/showcase.css';

interface Props {
	/** The effect's name. */
	title: string;
	/** The page's ground. Default `dark`. */
	theme?: 'dark' | 'light';
}

const { title, theme = 'dark' } = Astro.props;
---

<html lang="en-GB" class={theme}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title} · effects-astro</title>
		<script is:inline>
			if (window !== window.top || location.search.includes('bare')) document.documentElement.classList.add('is-bare');
		</script>
	</head>
	<body>
		<slot />
		<a class="fx-back" href="/">effects-astro <span>/</span> {title}</a>
	</body>
</html>
