---
import ScrambleText from '@arraypress/effects-astro/ScrambleText.astro';
import Typewriter from '@arraypress/effects-astro/Typewriter.astro';
import Reveal from '@arraypress/effects-astro/Reveal.astro';
import HighlightSweep from '@arraypress/effects-astro/HighlightSweep.astro';
import Marquee from '@arraypress/effects-astro/Marquee.astro';
---
<html><head><meta charset="utf-8"><title>text</title>
<style>html,body{margin:0;background:#0a0a0c;color:#fff;font-family:system-ui}main{max-width:1000px;margin:0 auto;padding:48px 24px}h1,h2{letter-spacing:-.03em}h1{font-size:64px;margin:0 0 40px}h2{font-size:40px;margin:0 0 40px}p{color:#888;font-size:13px;margin:32px 0 8px}</style></head>
<body><main>
<p>Reveal words</p><Reveal as="h1" words text="Skip the build. Start selling." />
<p>HighlightSweep + Typewriter</p><h2>Sell <HighlightSweep color="#c084fc">beats</HighlightSweep> and <Typewriter phrases={['sample packs', 'presets', 'courses']} caret="#c084fc" /></h2>
<p>ScrambleText hover</p><h2><ScrambleText text="Inference at the edge" hover /></h2>
<p>Reveal from="blur"</p><Reveal from="blur"><h2>Made for one kind of business</h2></Reveal>
</main>
<Marquee items={['Marcus Vane', 'Vivid Skye', 'Adrian Holt', 'Lunaire', 'Northwave']} separator="✦" />
<div style="height:24px"></div>
<Marquee items={['NEW BUNDLE', 'OUT NOW', 'LIMITED TIME']} separator="///" direction="right" speed={25} />
</body></html>
