---
/** The gallery's Text page. */
import Gallery from '../layouts/Gallery.astro';
import Hero from '../components/Hero.astro';
import ScrambleText from '@arraypress/effects-astro/ScrambleText.astro';
import Typewriter from '@arraypress/effects-astro/Typewriter.astro';
import Reveal from '@arraypress/effects-astro/Reveal.astro';
import ScrollReveal from '@arraypress/effects-astro/ScrollReveal.astro';
import HighlightSweep from '@arraypress/effects-astro/HighlightSweep.astro';
import Marquee from '@arraypress/effects-astro/Marquee.astro';
import { ACCENTS } from '../gallery';
import '@fontsource-variable/roboto-flex/full.css';
import '../styles/foundry.css';
import VariableType from '@arraypress/effects-astro/VariableType.astro';
---

<Gallery page="Text">
	<Hero id="reveal" name="Reveal" code={`<Reveal as="h2" words text="Good work deserves a good page." />`}>
		<Reveal as="h2" class="headline" words text="Good work deserves a good page." />
		<Reveal from="blur" delay={0.6}><p class="lede">Portfolios for illustrators, set up in an afternoon and yours for good.</p></Reveal>
	</Hero>
	<Hero id="typewriter" name="Typewriter" code={`<Typewriter phrases={['beats', 'sample packs', 'presets', 'courses']} caret="#c084fc" />`}>
		<h2 class="headline">Sell your<br /><Typewriter phrases={['beats', 'sample packs', 'presets', 'courses']} caret="#c084fc" /></h2>
	</Hero>
	<Hero id="scramble-text" name="ScrambleText" code={`<ScrambleText text="Zero knowledge, by design." hover />`}>
		<h2 class="headline" style="font-family: ui-monospace, Menlo, monospace; font-size: clamp(36px, 5.6vw, 80px)"><ScrambleText text="Zero knowledge, by design." hover /></h2>
		<p class="lede">Vaultline encrypts on your device, so not even we can read your files. Hover the headline to scramble it again.</p>
	</Hero>
	<Hero id="highlight-sweep" name="HighlightSweep" code={`<HighlightSweep color="#c084fc">beats</HighlightSweep>`}>
		<h2 class="headline">Sell <HighlightSweep color="var(--hero-accent)">beats</HighlightSweep>,<br />keep <HighlightSweep color="#34d399">every</HighlightSweep> penny.</h2>
	</Hero>
	<Hero id="marquee" name="Marquee" code={`<Marquee items={['Marcus Vane', 'Vivid Skye', 'Adrian Holt', 'Lunaire', 'Northwave', 'Kestrel']} separator="✦" />`}>
		<div class="bleed" style="display: grid; gap: 2rem">
			<div style="font-size: clamp(32px, 5vw, 64px); font-weight: 650; letter-spacing: -0.03em"><Marquee items={['Marcus Vane', 'Vivid Skye', 'Adrian Holt', 'Lunaire', 'Northwave', 'Kestrel']} separator="✦" /></div>
			<Marquee items={['NEW BUNDLE', 'OUT NOW', 'LIMITED TIME', 'FREE UPDATES']} separator="///" direction="right" speed={25} />
		</div>
	</Hero>
	<Hero id="scroll-reveal" name="ScrollReveal" code={`<ScrollReveal />  ·  <div class="fade-in-up">…</div>`}>
		<div style="display: grid; grid-template-columns: repeat(3, minmax(0, 220px)); gap: 20px">
			{['fade-in-up', 'zoom-in', 'flip-up', 'blur-in', 'slide-in-up', 'fade-in-left'].map((kind, i) => (
				<div class={kind} data-replay style={`--reveal-delay: ${(i % 3) * 0.08}s; height: 180px; border-radius: 16px; background: linear-gradient(160deg, ${ACCENTS[i]}, #18181b); display: grid; place-items: center; font: 600 15px ui-monospace, monospace`}>.{kind}</div>
			))}
		</div>
	</Hero>

	<ScrollReveal />
	<Hero id="variable-type" name="VariableType" theme="light" align="bottom" code={`<VariableType as="h2" fit>Torsion</VariableType>`} style="--hero-ground: #efebe3">
		<div class="foundry">
			<div class="foundry__bar"><span>Kiln Type Co.</span><span>Torsion Variable · New release</span><span>No. 07</span></div>
			<VariableType as="h2" class="foundry__word" fit>Torsion</VariableType>
			<div class="foundry__foot">
				<p>A grotesque that bends without breaking. Hairline to black, compressed to extended, one file. Run the pointer across it.</p>
				<dl>
					<div><dt>Weight</dt><dd>100–900</dd></div>
					<div><dt>Width</dt><dd>75–125</dd></div>
					<div><dt>Glyphs</dt><dd>1,180</dd></div>
				</dl>
			</div>
		</div>
	</Hero>
</Gallery>
