---
/** Each effect's page, from its file in src/showcase/. */
import Showcase from '../../layouts/Showcase.astro';
import { GALLERY } from '../../gallery.js';

const pieces = import.meta.glob('../../showcase/*.astro', { eager: true });

export function getStaticPaths() {
	return GALLERY.filter((entry) => !entry.href).map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const Piece = (pieces[`../../showcase/${entry.slug}.astro`] as { default: any }).default;
---

<Showcase title={entry.name} theme={entry.theme}><Piece /></Showcase>
