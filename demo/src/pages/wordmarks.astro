---
import PixelGlitchText from '@arraypress/effects-astro/PixelGlitchText.astro';
import OutlineWordmark from '@arraypress/effects-astro/OutlineWordmark.astro';
import SpotlightText from '@arraypress/effects-astro/SpotlightText.astro';
---
<html><head><meta charset="utf-8"><title>wordmarks</title>
<style>html,body{margin:0;background:#0a0a0c;color:#fff;font-family:system-ui}section{padding:48px 24px;border-bottom:1px solid #222;overflow:hidden}p{color:#888;font-size:13px;margin:0 0 12px}.wm{font-weight:800;letter-spacing:-.05em;line-height:.8}</style></head>
<body>
<section><p>PixelGlitchText fit stroke={1.5}</p><PixelGlitchText as="div" class="wm" fit stroke={1.5}>Northwave</PixelGlitchText></section>
<section><p>PixelGlitchText fit (solid)</p><PixelGlitchText as="div" class="wm" fit>Northwave</PixelGlitchText></section>
<section><p>SpotlightText fit fill="solid"</p><SpotlightText as="div" class="wm" fit fill="solid">LumiThemes</SpotlightText></section>
<section style="padding-bottom:0"><p>OutlineWordmark</p><OutlineWordmark text="ArrayPress" color="#a78bfa" /></section>
</body></html>
