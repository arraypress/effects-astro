---
import Backdrop from '@arraypress/effects-astro/Backdrop.astro';
import type { BackdropName } from '@arraypress/effects-astro/runtime/backdrop';

/** Every backdrop, as a tile; liquid ripples under the pointer, the rest lean towards it. */
const names: BackdropName[] = ['aurora', 'mesh', 'waves', 'grid', 'particles', 'grain', 'liquid', 'mesh-gradient', 'grain-gradient', 'water-plane', 'gradient-plane', 'gradient-sphere', 'beams', 'band-lens', 'silk'];
---
<html><head><meta charset="utf-8"><title>backdrop</title>
<style>
:root{--color-accent:#7c5cff;--color-bg:#0b0b10}
html,body{margin:0;background:var(--color-bg);color:#fff;font-family:system-ui}
.hero{position:relative;height:520px;overflow:hidden;display:grid;place-items:center}
.hero h1{position:relative;margin:0;font-size:72px;letter-spacing:-.03em;font-weight:600}
.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;padding:12px}
.tile{position:relative;height:200px;overflow:hidden;border-radius:10px;background:#111118}
.tile span{position:absolute;left:12px;top:10px;font:500 13px ui-monospace,monospace;opacity:.8}
</style></head>
<body>
<section class="hero"><Backdrop effect="silk" interactive /><h1>Backdrop</h1></section>
<div class="grid">
{names.map((name) => <div class="tile"><Backdrop effect={name} interactive fade="none" /><span>{name}</span></div>)}
</div>
</body></html>
