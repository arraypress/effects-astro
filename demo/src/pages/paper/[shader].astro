---
import PaperShader from '@arraypress/effects-astro/PaperShader.astro';
import { PRESETS } from '../../../../src/vendor/paper/presets.js';

/** One page a shader, showing every preset. */
export function getStaticPaths() {
	return Object.keys(PRESETS).map((shader) => ({ params: { shader } }));
}
const { shader } = Astro.params;
const presets = PRESETS[shader as keyof typeof PRESETS];
const pictures = ['fluted-glass', 'water', 'lens-distortion', 'image-dithering', 'halftone-dots', 'halftone-cmyk', 'paper-texture'];
const logos = ['liquid-metal', 'heatmap', 'gem-smoke'];
---
<html><head><meta charset="utf-8"><title>paper · {shader}</title>
<style>html,body{margin:0;background:#0b0b0e;color:#fff;font-family:system-ui}h1{margin:24px;font-size:28px}a{color:#a5b4fc}.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(380px,1fr));gap:12px;padding:0 24px 24px}figure{margin:0}.tile{position:relative;height:260px;border-radius:10px;overflow:hidden;background:repeating-conic-gradient(#a3a3a3 0 25%,#bdbdbd 0 50%) 0 0/20px 20px}figcaption{font-size:13px;color:#999;padding:6px 2px}</style></head>
<body><h1><a href="/paper">Paper</a> · {shader}</h1><div class="grid">
{presets.map((p) => (
	<figure><div class="tile">
		<PaperShader shader={shader as any} preset={p.name} image={logos.includes(shader) ? '/logo.svg' : undefined} gradient={pictures.includes(shader) ? ['#4f46e5', '#ec4899', '#f59e0b'] : undefined} />
	</div><figcaption>{p.name}</figcaption></figure>
))}
</div></body></html>
