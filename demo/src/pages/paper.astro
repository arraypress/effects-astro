---
import { PRESETS } from '../../../src/vendor/paper/presets.js';
---
<html><head><meta charset="utf-8"><title>paper</title></head>
<body style="font-family: system-ui; background:#0b0b0e; color:#fff; padding: 24px"><h1>Paper Shaders</h1><ul>
{Object.entries(PRESETS).map(([name, p]) => <li><a style="color:#a5b4fc" href={`/paper/${name}`}>{name}</a> <span style="color:#888">({p.map((x) => x.name).join(', ')})</span></li>)}
</ul></body></html>
