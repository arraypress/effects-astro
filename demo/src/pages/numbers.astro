---
import CountUp from '@arraypress/effects-astro/CountUp.astro';
import Range from '@arraypress/effects-astro/Range.astro';
import PulseMark from '@arraypress/effects-astro/PulseMark.astro';
import Carousel from '@arraypress/effects-astro/Carousel.astro';
import '@arraypress/effects-astro/tooltip.css';
import '@arraypress/effects-astro/motion.css';
const covers = ['#7c3aed', '#db2777', '#06b6d4', '#f59e0b', '#10b981', '#ef4444', '#3b82f6', '#a3e635'];
---
<html lang="en-GB"><head><meta charset="utf-8"><title>numbers and marks</title>
<style>html{background:#0b0b0e}body{margin:0;color:#e5e5e5;font-family:system-ui}main{max-width:900px;margin:0 auto;padding:56px 24px;display:grid;gap:56px}h2{font-size:13px;color:#888;font-weight:500;margin:0 0 16px;text-transform:uppercase;letter-spacing:.08em}.stats{display:flex;gap:48px}.stat b{display:block;font-size:44px;letter-spacing:-.02em}.stat>span{color:#888;font-size:14px}.calc{display:grid;gap:28px;max-width:560px}.result{font-size:48px;font-weight:800;color:#34d399}.marks{display:flex;gap:40px;align-items:center}.pill{padding:8px 14px;border:1px solid #333;border-radius:99px;font-size:14px}.pills{display:flex;gap:12px}.card{width:220px;height:280px;border-radius:14px;display:flex;align-items:flex-end;padding:16px;box-sizing:border-box;color:#fff;font-weight:600;text-decoration:none}</style></head>
<body><main>
<section><h2>CountUp</h2><div class="stats">
	<div class="stat"><b><CountUp value={12840} /></b><span>stores</span></div>
	<div class="stat"><b><CountUp value={2400000} currency="GBP" compact /></b><span>paid out</span></div>
	<div class="stat"><b><CountUp value={99.98} decimals={2} />%</b><span>uptime</span></div>
</div></section>
<section><h2>Range + CountUp</h2><div class="calc">
	<Range id="sales" label="Monthly sales" min={0} max={50000} step={500} value={8000} currency="GBP" decimals={0} color="#ff6b6b" />
	<Range id="fee" label="Their fee" min={0} max={10} step={0.5} value={5} decimals={1} color="#ff6b6b" />
	<div>You'd save <span class="result"><CountUp id="saving" value={4800} currency="GBP" decimals={0} /></span> a year</div>
</div></section>
<section><h2>PulseMark</h2><div class="marks">
	<PulseMark variant="matrix" size={64} color="#a855f7" glow />
	<PulseMark variant="rings" size={64} />
	<PulseMark variant="sonar" size={64} color="#00ff88" glow />
	<span style="font-size:18px;display:flex;gap:10px;align-items:center"><span class="fx-live"></span>Available for work</span>
</div></section>
<section><h2>tooltip.css</h2><div class="pills">
	<span class="pill" tabindex="0" data-tip="Sell licence keys with every download">Licence keys</span>
	<span class="pill" tabindex="0" data-tip="Below, this time" data-tip-side="bottom">Below</span>
	<span class="pill" tabindex="0" data-tip="Custom colours" style="--tip-bg:#18181b;--tip-color:#fff;--tip-border:#ff6b6b">Bordered</span>
</div></section>
<section><h2>Carousel</h2><Carousel label="Packs" buttons>{covers.map((c, i) => <a class="card" href="#" style={`background:linear-gradient(160deg,${c},#111)`}>Pack {i + 1}</a>)}</Carousel></section>
</main>
<script>
	const sales = /** @type {HTMLInputElement} */ (document.getElementById('sales'));
	const fee = /** @type {HTMLInputElement} */ (document.getElementById('fee'));
	const saving = /** @type {HTMLElement} */ (document.getElementById('saving'));
	const update = () => (saving.dataset.value = String(Math.round(Number(sales.value) * 12 * (Number(fee.value) / 100))));
	sales.addEventListener('input', update);
	fee.addEventListener('input', update);
</script>
</body></html>
