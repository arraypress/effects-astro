---
/** The gallery's Surfaces page. */
import Gallery from '../layouts/Gallery.astro';
import Hero from '../components/Hero.astro';
import PaletteChips from '../components/PaletteChips.astro';
import RadiantGlass from '@arraypress/effects-astro/RadiantGlass.astro';
import Glass from '@arraypress/effects-astro/Glass.astro';
import BorderSweep from '@arraypress/effects-astro/BorderSweep.astro';
import Tilt from '@arraypress/effects-astro/Tilt.astro';
import Parallax from '@arraypress/effects-astro/Parallax.astro';
import Magnetic from '@arraypress/effects-astro/Magnetic.astro';
import Cursor from '@arraypress/effects-astro/Cursor.astro';
import PulseMark from '@arraypress/effects-astro/PulseMark.astro';
import '@arraypress/effects-astro/motion.css';
---

<Gallery page="Surfaces">
	<Hero id="radiant-glass" name="RadiantGlass" code="<RadiantGlass />" align="right" style="--hero-ground: #060818">
		<RadiantGlass slot="effect" />
		<span class="eyebrow">Solace · smart lighting</span>
		<h2 class="headline" style="max-width: 10ch; margin-left: auto">Every room, <em>lit by feel.</em></h2>
		<p class="lede" style="max-width: 26rem">Lamps that learn how you live: bright for the work, low for the film, and amber for the slow end of the evening.</p>
		<div class="actions"><a class="btn" href="#">Shop the starter kit</a><a class="btn btn--ghost" href="#">See it after dark</a></div>
		<PaletteChips slot="tools" />
	</Hero>
	<Hero id="glass" name="Glass" code="<Glass>…</Glass>" style="--hero-ground: radial-gradient(70% 60% at 25% 30%, #0e7490, transparent 70%), radial-gradient(60% 60% at 80% 70%, #ea580c, transparent 70%), #0b0b10">
		<div class="row">
			{[['Solo', '£0', 'One calendar, unlimited bookings.'], ['Studio', '£12', 'Team calendars and deposits.'], ['Clinic', '£39', 'Rooms, staff and reminders.']].map(([plan, price, text]) => (
				<Glass style="width: 240px; padding: 28px; border-radius: 20px; text-align: left"><strong style="font-size: 20px">{plan}</strong><p style="color: #d4d4d8; font-size: 14px">{text}</p><b style="font-size: 40px; letter-spacing: -0.03em">{price}</b></Glass>
			))}
		</div>
	</Hero>
	<Hero id="border-sweep" name="BorderSweep" code={`<BorderSweep color="#22d3ee" always>…</BorderSweep>`} size="short">
		<div class="row">
			<BorderSweep color="#a78bfa" style="width: 300px; padding: 32px; border-radius: 18px; border: 1px solid #27272a; text-align: left"><strong style="font-size: 22px">Hover me</strong><p style="color: #a1a1aa">The light runs round on hover and focus.</p></BorderSweep>
			<BorderSweep color="#22d3ee" always style="width: 300px; padding: 32px; border-radius: 18px; border: 1px solid #27272a; text-align: left"><strong style="font-size: 22px">Featured</strong><p style="color: #a1a1aa">Or all the time, for the plan you want picked.</p></BorderSweep>
		</div>
	</Hero>
	<Hero id="tilt" name="Tilt" code={`<Tilt glare max={12} lift={10}>…</Tilt>`} size="short">
		<div class="row">
			{['#7c3aed', '#db2777', '#0891b2'].map((c, i) => (
				<Tilt glare max={12} lift={10} style={`width: 220px; height: 300px; border-radius: 18px; display: flex; align-items: flex-end; padding: 20px; box-sizing: border-box; font-weight: 600; font-size: 20px; background: linear-gradient(160deg, ${c}, #18181b)`}>Vol. {i + 1}</Tilt>
			))}
		</div>
	</Hero>
	<Hero id="parallax" name="Parallax" code={`<Parallax depth={60}>…</Parallax>`} size="short">
		<div data-parallax-root style="position: absolute; inset: 0; z-index: -1">
			<Parallax depth={-30} style="position: absolute; inset: 0; display: grid; place-items: center"><div style="width: 420px; height: 420px; border-radius: 50%; background: #0f766e; translate: -220px -40px"></div></Parallax>
			<Parallax depth={60} style="position: absolute; inset: 0; display: grid; place-items: center"><div style="width: 200px; height: 200px; border-radius: 50%; background: #f59e0b; translate: 240px 80px"></div></Parallax>
			<Parallax depth={100} style="position: absolute; inset: 0; display: grid; place-items: center"><div style="width: 80px; height: 80px; border-radius: 50%; background: #f472b6; translate: 60px -170px"></div></Parallax>
		</div>
		<span class="eyebrow">Wanderlight · weekend trips</span>
		<h2 class="headline">Somewhere new,<br /><em>every weekend.</em></h2>
	</Hero>
	<Hero id="magnetic" name="Magnetic" code={`<Magnetic as="a" href="/call" class="btn">Book a call</Magnetic>`} size="short">
		<span class="eyebrow">Ledgerly · bookkeeping</span>
		<h2 class="headline">Your books, done by Friday.</h2>
		<div class="actions" style="margin-top: 40px">
			<Magnetic as="a" href="#" class="btn" style="height: 58px; padding: 0 34px; font-size: 18px">Book a call</Magnetic>
			<Magnetic as="a" href="#" class="btn btn--ghost" strength={0.45} style="height: 58px; padding: 0 34px; font-size: 18px">See pricing</Magnetic>
		</div>
	</Hero>
	<Hero id="cursor" name="Cursor" code={`<Cursor blend="difference" />`} size="short">
		<template data-cursor-template><Cursor blend="difference" /></template>
		<div data-cursor-slot></div>
		<h2 class="headline">A softer pointer.</h2>
		<div class="actions"><button type="button" class="btn" data-cursor-toggle>Try the custom cursor</button><a class="btn btn--ghost" href="#" data-cursor="View">A link with a label</a></div>
	</Hero>
	<Hero id="pulse-mark" name="PulseMark · motion.css" code={`<PulseMark variant="sonar" size={120} color="#00ff88" glow />  ·  <span class="fx-live"></span>`} size="short">
		<div class="row" style="gap: 72px">
			<PulseMark variant="matrix" size={120} color="#f59e0b" glow />
			<PulseMark variant="rings" size={120} />
			<PulseMark variant="sonar" size={120} color="#00ff88" glow />
			<span style="display: inline-flex; align-items: center; gap: 12px; font-size: 22px"><span class="fx-live"></span>Available for work</span>
		</div>
	</Hero>
</Gallery>
