---
/** The gallery: every group's heroes, in order, on one page. */
import Gallery from '../layouts/Gallery.astro';
import { GROUPS } from '../tour/groups';
import { heroesOf } from '../tour/heroes';
---

<Gallery>
	{GROUPS.map(({ type }) => {
		const Heroes = heroesOf(type);
		return <Heroes />;
	})}
</Gallery>
