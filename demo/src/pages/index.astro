---
/** The gallery's Backgrounds page. */
import Gallery from '../layouts/Gallery.astro';
import Hero from '../components/Hero.astro';
import FilmScene from '../components/FilmScene.astro';
import LightField from '@arraypress/effects-astro/LightField.astro';
import Ink from '@arraypress/effects-astro/Ink.astro';
import InkField from '@arraypress/effects-astro/InkField.astro';
import AsciiRain from '@arraypress/effects-astro/AsciiRain.astro';
import FlutedGlass from '@arraypress/effects-astro/FlutedGlass.astro';
import DotGrid from '@arraypress/effects-astro/DotGrid.astro';
import DotSurface from '@arraypress/effects-astro/DotSurface.astro';
import SignalLines from '@arraypress/effects-astro/SignalLines.astro';
import WaveBars from '@arraypress/effects-astro/WaveBars.astro';
import WorldRoutes from '@arraypress/effects-astro/WorldRoutes.astro';
import GlowField from '@arraypress/effects-astro/GlowField.astro';
import Grain from '@arraypress/effects-astro/Grain.astro';
import HaloRing from '@arraypress/effects-astro/HaloRing.astro';
import SilkRibbon from '@arraypress/effects-astro/SilkRibbon.astro';
import ShaderBackground from '@arraypress/effects-astro/ShaderBackground.astro';
import { SHADER_BACKGROUNDS } from '@arraypress/effects-astro/runtime/shader-background';
import { ACCENTS, pitch } from '../gallery';
import Topography from '@arraypress/effects-astro/Topography.astro';
import Caustics from '@arraypress/effects-astro/Caustics.astro';
import RainOnGlass from '@arraypress/effects-astro/RainOnGlass.astro';
import '@arraypress/waveform-player/styles.css';
import '../styles/audio.css';
import Ocean from '@arraypress/effects-astro/Ocean.astro';
const shaders = Object.keys(SHADER_BACKGROUNDS) as (keyof typeof SHADER_BACKGROUNDS)[];
---

<Gallery page="Backgrounds">
	<Hero id="ink-field" name="InkField" code={`<InkField palette="Barbie" drops />`} style="--hero-ground: #08080a">
		<InkField slot="effect" palette="Barbie" drops />
		<span class="eyebrow">effects-astro · every effect, as a hero · press → for the next</span>
		<h1 class="headline">Pages that<br /><em>feel alive.</em></h1>
		<p class="lede">Ink in water, lit by a lamp that follows the pointer. Click to drop more, or press Customise: the ink on screen takes any palette you pick.</p>
	</Hero>


	<Hero id="light-field" name="LightField" code={`<LightField colors={['#e11d48', '#f97316', '#7c3aed']} glint="#fde68a" quiet={{ y: 0.42, radius: 0.6, depth: 0.7 }} />`}>
		<LightField slot="effect" colors={['#e11d48', '#f97316', '#7c3aed']} glint="#fde68a" quiet={{ y: 0.42, radius: 0.6, depth: 0.7 }} />
		<span class="eyebrow">Halcyon · sleep sounds</span>
		<h2 class="headline">Fall asleep<br /><em>in colour.</em></h2>
		<p class="lede">Slow soundscapes that drift with you, from the first yawn to deep sleep. Stir the light; click to drop in more.</p>
		<div class="actions"><a class="btn" href="#">Start a free week</a><a class="btn btn--ghost" href="#">Listen</a></div>
	</Hero>
	<Hero id="ink" name="Ink" code={`<Ink colors={['#2216f7', '#55bdff', '#a702ff']} />`} style="--hero-ground: #07070c">
		<Ink slot="effect" colors={['#2216f7', '#55bdff', '#a702ff']} />
		<span class="eyebrow">Brushwork · a lettering course</span>
		<h2 class="headline">Every stroke<br /><em>counts.</em></h2>
		<p class="lede">Six weeks of brush lettering, from your first line to a finished alphabet. Drag through the water to stir the ink.</p>
		<div class="actions"><a class="btn" href="#">Enrol for May</a><a class="btn btn--ghost" href="#">Watch a lesson</a></div>
	</Hero>
	<Hero id="ascii-rain" name="AsciiRain" code={`<AsciiRain quiet={{ x: 0.05, y: 0.25, radius: 0.7, depth: 0.95 }} />`} align="left" style="--hero-ground: #000">
		<AsciiRain slot="effect" quiet={{ x: 0.05, y: 0.25, radius: 0.7, depth: 0.95 }} />
		<span class="eyebrow">Tallyline · event analytics</span>
		<h2 class="headline">Every event,<br />accounted for.</h2>
		<p class="lede">Pipe in clicks, orders and errors from every service, then ask questions in plain English. Answers in seconds, not sprints.</p>
		<div class="actions"><a class="btn" href="#">Start free</a><a class="btn btn--ghost" href="#">See a live dashboard</a></div>
	</Hero>
	<Hero id="fluted-glass" name="FlutedGlass" code="<FlutedGlass />" theme="light" align="bottom">
		<FlutedGlass slot="effect" />
		<span class="eyebrow">Atelier Nord · interiors</span>
		<h2 class="headline">Rooms shaped<br />by <em>daylight.</em></h2>
	</Hero>
	<Hero id="dot-grid" name="DotGrid" code="<DotGrid />">
		<DotGrid slot="effect" />
		<span class="eyebrow">Stillpoint · meditation</span>
		<h2 class="headline">One breath<br />at a time.</h2>
		<p class="lede">A quiet timer with gentle bells and nothing else on the screen. Tap the water anywhere to begin.</p>
		<div class="actions"><a class="btn" href="#">Begin a session</a></div>
	</Hero>
	<Hero id="dot-surface" name="DotSurface" code={`<DotSurface color="#ff8a1f" quiet={{ x: 0.28, y: 0.5, radius: 0.7, depth: 0.85 }} />`} align="left" style="--hero-ground: #0b0b0b">
		<DotSurface slot="effect" color="#ff8a1f" quiet={{ x: 0.28, y: 0.5, radius: 0.7, depth: 0.85 }} />
		<span class="eyebrow" style="font-family: 'IBM Plex Mono', ui-monospace, monospace">Halyard · platform engineer · Lisbon or remote</span>
		<h2 class="headline" style="font-family: 'IBM Plex Mono', ui-monospace, monospace; font-weight: 500; font-size: clamp(34px, 4.6vw, 64px); line-height: 1.12; letter-spacing: -0.02em">Ship on Friday.<br /><span style="color: var(--hero-accent)">Sleep on Saturday.</span></h2>
		<p class="lede" style="font-family: 'IBM Plex Mono', ui-monospace, monospace; font-size: 16px">We build the release pipeline that rolls itself back before anyone's phone rings. Come help us make deploys boring.</p>
		<div class="actions"><a class="btn" href="#">See the role</a><a class="btn btn--ghost" href="#">Read our stack</a></div>
	</Hero>
	<Hero id="signal-lines" name="SignalLines" code={`<SignalLines quiet={{ radius: 0.6, depth: 0.5 }} />`}>
		<SignalLines slot="effect" quiet={{ radius: 0.6, depth: 0.5 }} />
		<span class="eyebrow">Northwave Records</span>
		<h2 class="headline">New music,<br />every Friday.</h2>
		<p class="lede">Stream the week's releases or buy them lossless, straight from the label that pressed them.</p>
		<div class="actions"><a class="btn" href="#">Listen now</a><a class="btn btn--ghost" href="#">Browse releases</a></div>
	</Hero>
	<Hero id="wave-bars" name="WaveBars" code={`<WaveBars colors={['#ff8a5c', '#ffd6a0', '#8fd3ff']} quiet={{ radius: 0.6, depth: 0.4 }} />`}>
		<WaveBars slot="effect" colors={['#ff8a5c', '#ffd6a0', '#8fd3ff']} quiet={{ radius: 0.6, depth: 0.4 }} />
		<span class="eyebrow">Hard Mode · a podcast</span>
		<h2 class="headline">Founders,<br /><em>unfiltered.</em></h2>
		<p class="lede">Forty minutes a week with people building companies the slow way. New episode every Tuesday.</p>
		<div class="actions"><a class="btn" href="#">Play episode 42</a><a class="btn btn--ghost" href="#">Subscribe</a></div>
	</Hero>
	<Hero id="world-routes" name="WorldRoutes" code={`<WorldRoutes home="edinburgh" routes={['new-york', 'toronto', 'lagos', 'cape-town', 'dubai', 'mumbai', 'singapore', 'hong-kong', 'tokyo', 'sydney']} colors={['#f8fafc', '#38bdf8', '#2dd4bf', '#a3e635', '#fbbf24', '#fb923c', '#fb7185']} gradient curve="great-circle" labels halo />`} align="bottom">
		<WorldRoutes slot="effect" home="edinburgh" routes={['new-york', 'toronto', 'lagos', 'cape-town', 'dubai', 'mumbai', 'singapore', 'hong-kong', 'tokyo', 'sydney']} colors={['#f8fafc', '#38bdf8', '#2dd4bf', '#a3e635', '#fbbf24', '#fb923c', '#fb7185']} gradient curve="great-circle" labels halo />
		<span class="eyebrow">Parcelpath · shipping</span>
		<h2 class="headline">Anywhere by Monday.</h2>
		<p class="lede">Labels, duties and tracking for 180 countries, priced before your customer reaches checkout.</p>
		<div class="actions"><a class="btn" href="#">Get shipping rates</a></div>
	</Hero>
	<Hero id="world-routes-europe" name="WorldRoutes" code={`<WorldRoutes region={[[34, -48], [66, 34]]} fit="cover" home="amsterdam" routes={['dublin', 'london', 'paris', 'madrid', 'milan', 'munich', 'copenhagen', 'stockholm', 'warsaw']} colors={['#fbbf24', '#2dd4bf']} gradient dotShape="square" graticule={10} dashed comets={2} labels />`} align="left">
		<WorldRoutes slot="effect" region={[[34, -48], [66, 34]]} fit="cover" home="amsterdam" routes={['dublin', 'london', 'paris', 'madrid', 'milan', 'munich', 'copenhagen', 'stockholm', 'warsaw']} colors={['#fbbf24', '#2dd4bf']} gradient dotShape="square" graticule={10} dashed comets={2} labels />
		<span class="eyebrow">Tessel · fulfilment</span>
		<h2 class="headline">Next day,<br /><em>nine countries.</em></h2>
		<p class="lede">Stock held in Amsterdam, packed by four and at the door by noon tomorrow, from Dublin to Warsaw.</p>
		<div class="actions"><a class="btn" href="#">See delivery times</a></div>
	</Hero>
	<Hero id="glow-field" name="GlowField" code={`<GlowField variant="beam" color="#f0abfc" />`}>
		<GlowField slot="effect" variant="beam" color="#f0abfc" />
		<span class="eyebrow">Opening night · 24 October</span>
		<h2 class="headline">The stage<br />is <em>yours.</em></h2>
		<p class="lede">An evening of new work from twelve young playwrights. Doors at seven, curtain at half past.</p>
		<div class="actions"><a class="btn" href="#">Book seats</a><a class="btn btn--ghost" href="#">The programme</a></div>
	</Hero>
	<Hero id="grain" name="Grain" code={`<Grain opacity={0.45} />`} style="--hero-ground: #0c1c22; --muted: #f1e2d6">
		<FilmScene slot="effect" />
		<Grain slot="effect" opacity={0.45} />
		<span class="eyebrow">Fieldnotes · film lab</span>
		<h2 class="headline">Shot on film.<br /><em>Kept for good.</em></h2>
		<p class="lede">Post us your rolls. We develop, scan and archive them, and your prints come back within the week.</p>
		<div class="actions"><a class="btn" href="#">Send a roll</a></div>
	</Hero>
	<Hero id="silk-ribbon" name="SilkRibbon" code="<SilkRibbon />" theme="light" align="left">
		<SilkRibbon slot="effect" />
		<span class="eyebrow">Maison Calloway · eau de parfum</span>
		<h2 class="headline">Worn like<br /><em>a second skin.</em></h2>
		<p class="lede">Rosa, our new scent: pink pepper and peony over warm cashmere wood. It settles close and stays until evening.</p>
		<div class="actions"><a class="btn" href="#">Shop Rosa · £96</a><a class="btn btn--ghost" href="#">Order a sample</a></div>
	</Hero>
	<Hero id="halo-ring" name="HaloRing" code="<HaloRing />" style="--hero-ground: #0d0c10">
		<HaloRing slot="effect" />
		<span class="eyebrow">Kestrel · launching Friday, 09:00</span>
		<h2 class="headline">Something new<br /><em>arrives Friday.</em></h2>
		<p class="lede">A pocket recorder that hears a room the way you do. Leave your email and you will hear it first.</p>
		<div class="actions"><a class="btn" href="#">Notify me</a></div>
	</Hero>
	<Hero id="topography" name="Topography" code={`<Topography labels quiet={{ x: 0.3, radius: 0.55, depth: 0.55 }} />`} align="left" style="--hero-ground: #0c1a2b">
		<Topography slot="effect" labels quiet={{ x: 0.3, radius: 0.55, depth: 0.55 }} />
		<span class="eyebrow">Fellwise · upland route guides</span>
		<h2 class="headline">Know the ground<br /><em>before you walk it.</em></h2>
		<p class="lede">Route guides for 140 hill walks, every climb and descent measured on foot. Printed on waterproof stock, or kept offline on your phone.</p>
		<div class="actions"><a class="btn" href="#">Find a route</a><a class="btn btn--ghost" href="#">How we survey</a></div>
	</Hero>
	<Hero id="topography-paper" name="Topography · paper" code={`<Topography colors={['#9a6b43', '#6e4529']} background="#f3ead6" labels quiet={{ radius: 0.6, depth: 0.6 }} />`} theme="light" style="--hero-ground: #f3ead6">
		<Topography slot="effect" colors={['#9a6b43', '#6e4529']} background="#f3ead6" labels quiet={{ radius: 0.6, depth: 0.6 }} />
		<span class="eyebrow">Fellwise Press · Atlas no. 4</span>
		<h2 class="headline">The western fells,<br /><em>line by line.</em></h2>
		<p class="lede">A 1:25,000 atlas drawn from three summers on foot: 62 routes, every cairn and stile, on paper that shrugs off the rain.</p>
		<div class="actions"><a class="btn" href="#">Pre-order, £38</a><a class="btn btn--ghost" href="#">See a sample sheet</a></div>
	</Hero>
	<Hero id="caustics" name="Caustics" code={`<Caustics tiles quiet={{ y: 0.45, radius: 0.6, depth: 0.5 }} />`} style="--hero-ground: #075a78; --muted: #e3fbff">
		<Caustics slot="effect" tiles quiet={{ y: 0.45, radius: 0.6, depth: 0.5 }} />
		<span class="eyebrow">Lido Verde · open-air pool &amp; spa</span>
		<h2 class="headline">Fifty metres<br /><em>of summer.</em></h2>
		<p class="lede">A heated outdoor pool under the plane trees, open from seven till late. Swim a few lengths, then stay for the sauna and the long lunch.</p>
		<div class="actions"><a class="btn" href="#">Book a day pass</a><a class="btn btn--ghost" href="#">See the spa</a></div>
	</Hero>
	<Hero id="caustics-ocean" name="Caustics · ocean" code={`<Caustics colors={['#0b4f9c', '#05214d', '#9fdcff']} scale={1.4} intensity={0.8} />`} align="left" style="--hero-ground: #031634; --muted: #cfe6ff">
		<Caustics slot="effect" colors={['#0b4f9c', '#05214d', '#9fdcff']} scale={1.4} intensity={0.8} />
		<span class="eyebrow">Fathom · swimwear</span>
		<h2 class="headline">Made for<br /><em>open water.</em></h2>
		<p class="lede">Suits cut from recycled fishing nets, tested off the Cornish coast through every month of the year.</p>
		<div class="actions"><a class="btn" href="#">Shop the collection</a><a class="btn btn--ghost" href="#">Find your fit</a></div>
	</Hero>
	<Hero id="caustics-amber" name="Caustics · amber" code={`<Caustics palette="Saffron" speed={0.6} intensity={0.9} quiet={{ y: 0.5, radius: 0.55, depth: 0.6 }} />`} style="--hero-ground: #2a0c04; --muted: #fff1d6">
		<Caustics slot="effect" palette="Saffron" speed={0.6} intensity={0.9} quiet={{ y: 0.5, radius: 0.55, depth: 0.6 }} />
		<span class="eyebrow">Amberhaus · thermal baths</span>
		<h2 class="headline">Warm water,<br /><em>after dark.</em></h2>
		<p class="lede">Evening bathing by lamplight: three mineral pools, a steam room and honeyed tea by the fire. Late sessions every Friday and Saturday.</p>
		<div class="actions"><a class="btn" href="#">Reserve an evening</a></div>
	</Hero>
	<Hero id="rain-on-glass" name="RainOnGlass" code={`<RainOnGlass src="/photos/rain-on-glass-1.jpg" alt="A wet street at night under neon signs and umbrellas" />`} align="left" style="--hero-ground: #0a0d12">
		<RainOnGlass slot="effect" src="/photos/rain-on-glass-1.jpg" alt="A wet street at night under neon signs and umbrellas" />
		<span class="eyebrow">Halfmoon · café &amp; listening bar</span>
		<h2 class="headline">Take the window.<br /><em>Let it pour.</em></h2>
		<p class="lede">Slow coffee by day, natural wine and records after dark. Open till one on Kettle Street, with the best seat in the house for a wet night. Wipe the glass to see out.</p>
		<div class="actions"><a class="btn" href="#">Book the window table</a><a class="btn btn--ghost" href="#">Tonight's records</a></div>
	</Hero>
	<Hero id="wave-bars-audio" name="WaveBars · audio" code={`<WaveBars audio="#tidewater" quiet={{ x: 0.28, radius: 0.7, depth: 0.5 }} />`} align="left" style="--hero-ground: #050b0d">
		<WaveBars slot="effect" audio="#tidewater" quiet={{ x: 0.28, radius: 0.7, depth: 0.5 }} />
		<div class="audio-split">
			<div>
				<span class="eyebrow">Low Tide Audio · sample packs</span>
				<h2 class="headline">Loops that hit<br /><em>like weather.</em></h2>
				<p class="lede">Tidewater Vol. 2: 140 drums, keys and leads, recorded to tape in a Bristol boathouse. Press play and the page plays along.</p>
				<div class="actions"><a class="btn" href="#">Buy the pack · £24</a><a class="btn btn--ghost" href="#">Hear all 140</a></div>
			</div>
			<div class="audio-pack" id="tidewater">
				<div data-waveform-player data-url="/audio/drum-loop.mp3" data-title="Harbour Kit" data-artist="Drums · 124 BPM" data-color-preset="dark" data-height="34" data-waveform-color="rgba(214, 236, 255, 0.28)" data-progress-color="#2dd4bf"></div>
				<div data-waveform-player data-url="/audio/keys-house-piano.mp3" data-title="Slipway Keys" data-artist="House piano · A minor" data-color-preset="dark" data-height="34" data-waveform-color="rgba(214, 236, 255, 0.28)" data-progress-color="#d6ecff"></div>
				<div data-waveform-player data-url="/audio/lead-surprise-kiss.mp3" data-title="Saltglass Lead" data-artist="Lead · F major" data-color-preset="dark" data-height="34" data-waveform-color="rgba(214, 236, 255, 0.28)" data-progress-color="#f6b26b"></div>
			</div>
		</div>
	</Hero>
	<Hero id="signal-lines-audio" name="SignalLines · audio" code={`<SignalLines audio="#kestrel" quiet={{ radius: 0.6, depth: 0.5 }} />`} style="--hero-ground: #06080c">
		<SignalLines slot="effect" audio="#kestrel" quiet={{ radius: 0.6, depth: 0.5 }} />
		<span class="eyebrow">Kestrel Radio · Leeds</span>
		<h2 class="headline">Live from<br /><em>the top floor.</em></h2>
		<p class="lede">Independent radio from a converted mill: new records, long interviews and no adverts, round the clock.</p>
		<div class="audio-pack audio-pack--one" id="kestrel">
			<div data-waveform-player data-url="/audio/keys-house-piano.mp3" data-title="Morning Session" data-artist="Kestrel Radio · on air now" data-color-preset="dark" data-height="40" data-waveform-color="rgba(214, 236, 255, 0.3)" data-progress-color="#4fd1c5"></div>
		</div>
	</Hero>
	<Hero id="ink-field-audio" name="InkField · audio" code={`<InkField palette="Peacock" audio="#night-shift" />`} style="--hero-ground: #08080a">
		<InkField slot="effect" palette="Peacock" audio="#night-shift" />
		<span class="eyebrow">Velvet Static · records</span>
		<h2 class="headline">Night Shift,<br /><em>out Friday.</em></h2>
		<p class="lede">Eight tracks of slow-burning dub techno from the Velvet Static basement. Hear the lead single before it lands.</p>
		<div class="audio-pack audio-pack--one" id="night-shift">
			<div data-waveform-player data-url="/audio/drum-loop.mp3" data-title="Low Light" data-artist="Velvet Static · lead single" data-color-preset="dark" data-height="40" data-waveform-color="rgba(255, 255, 255, 0.3)" data-progress-color="#ffffff"></div>
		</div>
	</Hero>
	<Hero id="ocean" name="Ocean" code="<Ocean />" align="left" style="--hero-ground: #1c2a4a; --muted: #fbe6d4">
		<Ocean slot="effect" />
		<span class="eyebrow">Halyard &amp; Co. · sailing charters, Falmouth</span>
		<h2 class="headline">Leave the harbour<br /><em>at golden hour.</em></h2>
		<p class="lede">Skippered evening sails on a classic wooden ketch. Six guests, a cool box of local cider, and nothing ahead of the bow but open water.</p>
		<div class="actions"><a class="btn" href="#">Book a sunset sail</a><a class="btn btn--ghost" href="#">Meet the boat</a></div>
	</Hero>
	<Hero id="ocean-night" name="Ocean · night" code={`<Ocean time="night" />`} style="--hero-ground: #070b1a; --muted: #c9d4ee">
		<Ocean slot="effect" time="night" />
		<span class="eyebrow">Lantern House · a hotel on the cliff</span>
		<h2 class="headline">Fall asleep<br /><em>to the tide.</em></h2>
		<p class="lede">Eleven rooms above the bay, each with a window on the sea. Shutters open, the moon on the water, the kettle on for morning.</p>
		<div class="actions"><a class="btn" href="#">Check availability</a></div>
	</Hero>
	{
		shaders.map((effect, i) => (
			<Hero id={`shader-${effect}`} name={`ShaderBackground · ${effect}`} code={`<ShaderBackground effect="${effect}" interactive />`} style={`--color-accent: ${ACCENTS[i % ACCENTS.length]}`}>
				<ShaderBackground slot="effect" effect={effect} interactive />
				<span class="eyebrow">{pitch(i).brand}</span>
				<h2 class="headline">{pitch(i).headline}</h2>
				<p class="lede">{pitch(i).lede}</p>
				<div class="actions"><a class="btn" href="#">{pitch(i).cta}</a></div>
				<span slot="tools" class="chip is-note">--color-accent: {ACCENTS[i % ACCENTS.length]}</span>
			</Hero>
		))
	}
</Gallery>

<script>
	// The audio heroes' players: WaveformPlayer finds its [data-waveform-player] elements itself.
	import '@arraypress/waveform-player';
</script>
