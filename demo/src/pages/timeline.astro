---
import Timeline from '@arraypress/effects-astro/Timeline.astro';
const items = [
	{ date: '2016', title: 'The first pack', text: 'Eighty drum hits recorded in a spare room, sold from a one-page site.' },
	{ date: '2017–2019', title: 'Building a library', text: 'Forty packs across house, techno and hip-hop, and the first collaborations.' },
	{ date: '2020', title: 'Going independent', text: 'Leaving the marketplaces to sell direct, with instant downloads.' },
	{ date: '2020+', title: 'The foundry', text: 'A team of six, and a pack every month.' },
];
---
<html><head><meta charset="utf-8"><title>timeline</title>
<style>html{background:#0b0b0e}body{margin:0;color:#e5e5e5;font-family:system-ui}main{max-width:560px;margin:0 auto;padding:60vh 24px}</style></head>
<body><main><Timeline items={items} current={3} color="#d334cc" /></main></body></html>
