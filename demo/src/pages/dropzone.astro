---
import Dropzone from '@arraypress/effects-astro/Dropzone.astro';
---
<html><head><meta charset="utf-8"><title>dropzone</title>
<style>html{background:#0b0b0e}body{margin:0;color:#e5e5e5;font-family:system-ui}main{max-width:640px;margin:0 auto;padding:64px 24px;display:grid;gap:28px}h2{font-size:15px;margin:0 0 4px}p{margin:0;color:#888;font-size:13px}.light{background:#f6f5f2;color:#222;padding:28px;border-radius:16px}</style></head>
<body><main>
<Dropzone id="zone" accept=".csv,.pdf" color="#f43f5e" label="Upload a bank statement">
	<div><h2>Drop your bank statement</h2><p>CSV or PDF, or click to choose</p></div>
	<div slot="busy"><h2>Scanning <span id="file"></span></h2><p>Matching against 214 known patterns</p></div>
</Dropzone>
<Dropzone busy color="#22d3ee"><div><h2>Idle content</h2></div><div slot="busy"><h2>Always busy</h2><p>The scanning state</p></div></Dropzone>
<div class="light"><Dropzone multiple color="#7c3aed"><div><h2>Drop your stems</h2><p>Any number of files</p></div></Dropzone></div>
</main>
<script>
	const zone = /** @type {HTMLElement} */ (document.getElementById('zone'));
	zone.addEventListener('change', (e) => {
		const input = /** @type {HTMLInputElement} */ (e.target);
		/** @type {HTMLElement} */ (document.getElementById('file')).textContent = input.files?.[0]?.name ?? '';
		zone.dataset.busy = '';
		setTimeout(() => delete zone.dataset.busy, 3000);
	});
</script>
</body></html>
