---
/**
 * DitherGradient: a soft colour gradient drawn only in dots: a wavy
 * horizon, a glowing band, a swirl, a pinwheel or stepped columns, square
 * dots an ordered dither thins out or round halftone dots that shrink. See
 * src/runtime/dither-gradient.js.
 *
 * Fills its nearest positioned ancestor, or the viewport with `fixed`.
 * Clear where there is nothing drawn, so it lays over any ground; with a
 * `background`, the element shows a CSS still until the shader starts and
 * without WebGL.
 *
 * @example
 * <section class="hero" style="position: relative; background: #0b0b0b">
 *   <DitherGradient background="#081226" colors={['#5a0f4a', '#ff1f8f']} shape="wave" quiet={{ radius: 0.5, depth: 1 }} />
 *   <h1>…</h1>
 * </section>
 */
import EffectCanvas from './EffectCanvas.astro';
import { gradientStill, type DitherGradientConfig } from '../runtime/dither-gradient.js';

interface Props extends DitherGradientConfig {
	/** Fill the viewport (position: fixed). Default false. */
	fixed?: boolean;
	/** Run only while near the screen (true, or how near as a CSS length), giving its WebGL context back when away: for pages with many effects. Default false. */
	lazy?: boolean | string;
	class?: string;
}

const { fixed = false, lazy = false, class: className, ...config } = Astro.props;
const still = config.background ? gradientStill(config) : undefined;
---

<EffectCanvas name="dither-gradient" config={config} fixed={fixed} lazy={lazy} background={still} class={className} />

<script>
	import { mount } from '../runtime/mount.js';
	import { ditherGradient } from '../runtime/dither-gradient.js';

	mount('[data-effect-dither-gradient]', ditherGradient);
</script>
