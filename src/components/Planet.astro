---
/**
 * Planet: a planet seen from low orbit at sunrise: the vast dark curve of its night side across the lower frame (city
 * lights on the Earth), the thin lit air along its limb, the sun cresting the limb and setting back over a slow cycle
 * with an anamorphic flare along the horizon, the planet turning slowly. The Earth needs its two maps (`day`, `aux`;
 * NASA Blue Marble and Black Marble, public domain); `mars`, `moon` and `giant` are drawn from noise. See
 * src/runtime/planet.js.
 *
 * Fills its nearest positioned ancestor, or the viewport with `fixed`. Opaque: it paints space black; the element shows
 * a CSS still of it until the shader starts and without WebGL.
 *
 * @example
 * <section class="hero" style="position: relative; background: #000">
 *   <Planet day="/img/earth-day.webp" aux="/img/earth-aux.webp" sunX={0.62} />
 *   <h1>…</h1>
 * </section>
 */
import EffectCanvas from './EffectCanvas.astro';
import { planetStill, type PlanetConfig } from '../runtime/planet.js';

interface Props extends PlanetConfig {
	/** Fill the viewport (position: fixed). Default false. */
	fixed?: boolean;
	/** Run only while near the screen (true, or how near as a CSS length), giving its WebGL context back when away. Default false. */
	lazy?: boolean | string;
	class?: string;
}

const { fixed = false, lazy = false, class: className, ...config } = Astro.props;
const still = planetStill(config);
---

<EffectCanvas name="planet" config={config} fixed={fixed} lazy={lazy} background={still} class={className} />

<script>
	import { mount } from '../runtime/mount.js';
	import { planet } from '../runtime/planet.js';

	mount('[data-effect-planet]', planet);
</script>
