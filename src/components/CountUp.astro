---
/**
 * CountUp: a number that counts up to its value as it scrolls into view,
 * easing in to land: revenue, downloads, customers. Set a new
 * `data-value` on it later and it glides there (a calculator's result).
 * The number is written the reader's way (`currency`, `decimals`,
 * `compact`, `locale`), and is in the page from the start. See
 * src/runtime/count-up.js.
 *
 * @example
 * <CountUp value={1240} currency="GBP" />
 */
import type { HTMLTag } from 'astro/types';
import type { CountUpConfig } from '../runtime/count-up.js';
import { numberFormat } from '../runtime/number-format.js';

interface Props extends CountUpConfig {
	/** The number it lands on. */
	value: number;
	/** The element to render. Default `span`. */
	as?: HTMLTag;
	class?: string;
	[attribute: string]: unknown;
}

const { value, as: Tag = 'span', from, duration, locale, currency, decimals, compact, class: className, ...attributes } = Astro.props;
const config = { from, duration, locale, currency, decimals, compact };
---

<Tag
	class:list={['effect-count-up', className]}
	data-effect-count-up
	data-value={value}
	data-effect-config={JSON.stringify(config)}
	{...attributes}>{numberFormat(config)(value)}</Tag
>

<script>
	import { mount } from '../runtime/mount.js';
	import { countUp } from '../runtime/count-up.js';

	mount('[data-effect-count-up]', countUp);
</script>

<style>
	.effect-count-up {
		font-variant-numeric: tabular-nums;
	}
</style>
