---
/**
 * Range: a slider with its label and its value, the track filled up to
 * the thumb and the thumb swelling as it is held. For calculators and
 * filters: pair it with `<CountUp>` to show a result that glides as it
 * moves. It is a real `<input type="range">` (keyboard, forms, `input`
 * events); the value is written the reader's way. See src/runtime/range.js.
 *
 * @example
 * <Range id="sales" label="Monthly sales" min={0} max={50000} step={500} value={5000} currency="GBP" color="#ff6b6b" />
 */
import type { NumberStyle } from '../runtime/number-format.js';
import { numberFormat } from '../runtime/number-format.js';

interface Props extends NumberStyle {
	/** The input's id, which the value's `<output>` refers to. */
	id: string;
	/** The label. */
	label: string;
	/** The input's name, for forms. */
	name?: string;
	/** Lowest value. Default 0. */
	min?: number;
	/** Highest value. Default 100. */
	max?: number;
	/** Step between values. Default 1. */
	step?: number;
	/** Starting value. Default the middle. */
	value?: number;
	/** The fill and thumb colour. Default the text colour. */
	color?: string;
	class?: string;
}

const { id, label, name, min = 0, max = 100, step = 1, value = (min + max) / 2, color, locale, currency, decimals, compact, class: className } = Astro.props;
const config = { locale, currency, decimals, compact };
---

<div class:list={['effect-range', className]} style={color ? `--range-color: ${color}` : undefined}>
	<div class="head">
		<label for={id}>{label}</label>
		<output for={id}>{numberFormat(config)(value)}</output>
	</div>
	<input
		type="range"
		id={id}
		name={name}
		min={min}
		max={max}
		step={step}
		value={value}
		style={`--fill: ${((value - min) / (max - min || 1)) * 100}%`}
		data-effect-range
		data-effect-config={JSON.stringify(config)}
	/>
</div>

<script>
	import { mount } from '../runtime/mount.js';
	import { range } from '../runtime/range.js';

	mount('[data-effect-range]', range);
</script>

<style>
	.effect-range {
		--c: var(--range-color, currentColor);
		display: grid;
		gap: 0.75rem;
	}
	.head {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1rem;
	}
	output {
		font-weight: 600;
		color: var(--c);
		font-variant-numeric: tabular-nums;
	}

	input {
		width: 100%;
		color: inherit;
		height: 1.25rem;
		margin: 0;
		background: none;
		cursor: pointer;
		appearance: none;
		-webkit-appearance: none;
	}
	input::-webkit-slider-runnable-track {
		height: 6px;
		border-radius: 3px;
		background: linear-gradient(90deg, var(--c) var(--fill), color-mix(in srgb, currentColor 14%, transparent) var(--fill));
	}
	input::-moz-range-track {
		height: 6px;
		border-radius: 3px;
		background: linear-gradient(90deg, var(--c) var(--fill), color-mix(in srgb, currentColor 14%, transparent) var(--fill));
	}
	input::-webkit-slider-thumb {
		width: 20px;
		height: 20px;
		margin-top: -7px;
		border: 0;
		border-radius: 50%;
		background: var(--c);
		box-shadow: 0 2px 10px color-mix(in srgb, var(--c) 35%, transparent);
		transition:
			scale 0.15s ease,
			box-shadow 0.15s ease;
		-webkit-appearance: none;
	}
	input::-moz-range-thumb {
		width: 20px;
		height: 20px;
		border: 0;
		border-radius: 50%;
		background: var(--c);
		box-shadow: 0 2px 10px color-mix(in srgb, var(--c) 35%, transparent);
		transition:
			scale 0.15s ease,
			box-shadow 0.15s ease;
	}
	input:active::-webkit-slider-thumb {
		scale: 1.2;
		box-shadow: 0 0 0 8px color-mix(in srgb, var(--c) 18%, transparent);
	}
	input:active::-moz-range-thumb {
		scale: 1.2;
		box-shadow: 0 0 0 8px color-mix(in srgb, var(--c) 18%, transparent);
	}
	input:focus-visible {
		outline: none;
	}
	input:focus-visible::-webkit-slider-thumb {
		box-shadow: 0 0 0 4px color-mix(in srgb, var(--c) 35%, transparent);
	}
	input:focus-visible::-moz-range-thumb {
		box-shadow: 0 0 0 4px color-mix(in srgb, var(--c) 35%, transparent);
	}

	@media (prefers-reduced-motion: reduce) {
		input::-webkit-slider-thumb {
			transition: none;
		}
		input::-moz-range-thumb {
			transition: none;
		}
	}
</style>
