---
/**
 * BackToTop: a round button that floats in once the page has been
 * scrolled a little way and takes you back to the top; it hides near the
 * bottom so it never covers the footer, and while hidden it cannot be
 * tabbed to. Smooth scrolling unless reduced motion is asked for. See
 * src/runtime/scroll-chrome.js.
 *
 * @example
 * <BackToTop label="Back to top" />
 */

interface Props {
	/** Its label, for screen readers and the tooltip. Default `Back to top`. */
	label?: string;
	/** Scroll depth before it appears, in screen heights. Default 0.4. */
	after?: number;
	/** Which corner. Default `right`. */
	side?: 'left' | 'right';
	class?: string;
}

const { label = 'Back to top', after = 0.4, side = 'right', class: className } = Astro.props;
---

<button
	type="button"
	class:list={['effect-back-to-top', `on-${side}`, className]}
	data-effect-back-to-top
	data-after={after}
	data-show="false"
	aria-label={label}
	title={label}
	aria-hidden="true"
	inert
>
	<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M12 19V5M5 12l7-7 7 7"></path>
	</svg>
</button>

<script>
	import { scrollChrome } from '../runtime/scroll-chrome.js';

	scrollChrome();
</script>

<style>
	.effect-back-to-top {
		position: fixed;
		bottom: 1.25rem;
		z-index: 50;
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		padding: 0;
		border: 1px solid color-mix(in srgb, currentColor 22%, transparent);
		border-radius: 999px;
		background: color-mix(in srgb, Canvas 85%, transparent);
		color: inherit;
		cursor: pointer;
		opacity: 0;
		translate: 0 0.75rem;
		transition: opacity 0.25s ease, translate 0.25s ease;
	}
	.on-right {
		right: 1.25rem;
	}
	.on-left {
		left: 1.25rem;
	}
	.effect-back-to-top[data-show='true'] {
		opacity: 1;
		translate: 0 0;
	}
	.effect-back-to-top svg {
		width: 1.1rem;
		height: 1.1rem;
	}
	@media (prefers-reduced-motion: reduce) {
		.effect-back-to-top {
			transition: none;
		}
	}
</style>
