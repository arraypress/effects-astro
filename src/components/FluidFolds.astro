---
/**
 * FluidFolds: glossy folds of liquid colour on a dark ground, warped by slow
 * noise and lit from one side, the colour drifting along a ramp of three;
 * poured enamel (`style="liquid"`) or long silk dunes (`style="dunes"`). No
 * pointer, made to sit behind copy. See src/runtime/fluid-folds.js.
 *
 * Fills its nearest positioned ancestor, or the viewport with `fixed`.
 * Opaque: it paints its `background` (default near-black) everywhere; the
 * element shows a CSS still of it until the shader starts and without WebGL.
 *
 * @example
 * <section class="hero" style="position: relative; background: #050409">
 *   <FluidFolds colors={['#1638ff', '#7b2cff', '#ff4a3d']} style="liquid" />
 *   <h1>…</h1>
 * </section>
 */
import EffectCanvas from './EffectCanvas.astro';
import { foldsStill, type FluidFoldsConfig } from '../runtime/fluid-folds.js';

interface Props extends FluidFoldsConfig {
	/** Fill the viewport (position: fixed). Default false. */
	fixed?: boolean;
	/** Run only while near the screen (true, or how near as a CSS length), giving its WebGL context back when away: for pages with many effects. Default false. */
	lazy?: boolean | string;
	class?: string;
}

const { fixed = false, lazy = false, class: className, ...config } = Astro.props;
const still = foldsStill(config);
---

<EffectCanvas name="fluid-folds" config={config} fixed={fixed} lazy={lazy} background={still} class={className} />

<script>
	import { mount } from '../runtime/mount.js';
	import { fluidFolds } from '../runtime/fluid-folds.js';

	mount('[data-effect-fluid-folds]', fluidFolds);
</script>
