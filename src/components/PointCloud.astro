---
/**
 * PointCloud: a word drawn as a matrix of bright dots among rippling sheets
 * of point cloud, the scene tilting towards the pointer. With `trackers`,
 * boxes lock onto the word like a detector's debug view.
 * See src/runtime/point-cloud.js.
 *
 * Opaque: it is the whole background of what it fills (its nearest
 * positioned ancestor, or the viewport with `fixed`). Without WebGL the
 * `background` colour shows. The word is decoration: put the real
 * headline in the page too (it can be visually hidden).
 *
 * @example
 * <section class="hero" style="position: relative">
 *   <PointCloud text="inference" />
 * </section>
 */
import EffectCanvas from './EffectCanvas.astro';
import type { PointCloudConfig } from '../runtime/point-cloud.js';

interface Props extends PointCloudConfig {
	/** Fill the viewport, behind the page (position: fixed, z-index -1). Default false. */
	fixed?: boolean;
	class?: string;
}

const { fixed = false, class: className, ...config } = Astro.props;
---

<EffectCanvas name="point-cloud" config={config} fixed={fixed} class={className} behind background={config.background ?? '#020205'} />

<script>
	import { mount } from '../runtime/mount.js';
	import { pointCloud } from '../runtime/point-cloud.js';

	mount('[data-effect-point-cloud]', pointCloud);
</script>
