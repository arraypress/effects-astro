---
/**
 * Backdrop: six animated shader backgrounds for a hero or section,
 * tinted from `--color-accent` with no settings (the page's, or a
 * section's own): mesh-gradient, grain-gradient, silk, band-lens, grid
 * and waves. See src/runtime/backdrop.js.
 *
 * Fills its nearest positioned ancestor (or the viewport with `fixed`)
 * and fades out towards the bottom by default. Each is light over the
 * page, clear where it is dark. Pass `static` for one frame when it is
 * wallpaper behind body copy. Without WebGL, soft gradients in the same
 * colours stand in.
 *
 * @example
 * <section style="position: relative">
 *   <Backdrop effect="silk" speed={0.6} intensity={0.7} />
 *   <h1>Your hero</h1>
 * </section>
 * <Backdrop effect="mesh-gradient" static frame={14} intensity={0.45} fade="none" fixed />
 */
import EffectCanvas from './EffectCanvas.astro';
import type { BackdropConfig } from '../runtime/backdrop.js';

interface Props extends BackdropConfig {
	/** Its opacity, 0–1, to fade it against the section without changing the shader. Default 1. */
	opacity?: number;
	/** CSS `mix-blend-mode` with what is behind it (`screen`, `lighten`, `plus-lighter`…), for layering over imagery. Default normal. */
	blend?: string;
	/** Fade it out towards an edge, so it melts into the page: 'bottom', 'top', 'both' (top and bottom) or 'none'. Default 'bottom'. */
	fade?: 'none' | 'bottom' | 'top' | 'both';
	/** Fill the viewport, behind the page (position: fixed, z-index -1). Default false. */
	fixed?: boolean;
	class?: string;
}

const { opacity = 1, blend, fade = 'bottom', fixed = false, class: className, ...config } = Astro.props;
---

<EffectCanvas
	name="backdrop"
	config={config}
	fixed={fixed}
	behind
	opacity={opacity}
	blend={blend}
	fade={fade === 'none' ? false : fade}
	class={className}
/>

<script>
	import { mount } from '../runtime/mount.js';
	import { backdrop } from '../runtime/backdrop.js';

	mount('[data-effect-backdrop]', backdrop);
</script>
