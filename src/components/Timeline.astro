---
/**
 * Timeline: dated steps down a line that fills with colour as the page
 * scrolls, each dot lighting as the fill reaches it, and the `current`
 * step's dot breathing. For a company's story, a roadmap, how an order
 * is made. See src/runtime/timeline.js.
 *
 * From the Sample Foundry site.
 *
 * @example
 * <Timeline color="#d334cc" current={3} items={[
 *   { date: '2016', title: 'First pack', text: 'Recorded in a spare room.' },
 *   { date: '2020+', title: 'The foundry', text: 'Now a team of six.' },
 * ]} />
 */
import '../styles/motion.css';

interface Props {
	/** The steps, in order. `text` is optional. */
	items: { date: string; title: string; text?: string }[];
	/** The index of the step that is happening now, which breathes. Default none. */
	current?: number;
	/** The fill and dot colour. Default the text colour. */
	color?: string;
	class?: string;
}

const { items, current, color, class: className } = Astro.props;
---

<ol class:list={['effect-timeline', className]} style={color ? `--timeline-color: ${color}` : undefined} data-effect-timeline>
	{
		items.map((item, i) => (
			<li class:list={['item', { 'is-current': i === current }]} data-timeline-item aria-current={i === current ? 'step' : undefined}>
				<span class:list={['dot', { 'fx-live': i === current }]} aria-hidden="true" />
				<span class="date">{item.date}</span>
				<h3>{item.title}</h3>
				{item.text && <p>{item.text}</p>}
			</li>
		))
	}
</ol>

<script>
	import { mount } from '../runtime/mount.js';
	import { timeline } from '../runtime/timeline.js';

	mount('[data-effect-timeline]', timeline);
</script>

<style>
	.effect-timeline {
		--c: var(--timeline-color, currentColor);
		--rail: color-mix(in srgb, currentColor 16%, transparent);
		position: relative;
		margin: 0;
		padding: 0 0 0 2rem;
		list-style: none;
	}
	/* The rail, and the fill over it. */
	.effect-timeline::before,
	.effect-timeline::after {
		content: '';
		position: absolute;
		top: 0.5rem;
		bottom: 0.5rem;
		left: 4px;
		width: 2px;
		border-radius: 1px;
		background: var(--rail);
	}
	.effect-timeline::after {
		background: linear-gradient(transparent, var(--c) 3rem);
		transform-origin: top;
		scale: 1 var(--progress, 0);
	}

	.item {
		position: relative;
		padding-bottom: 2.5rem;
	}
	.item:last-child {
		padding-bottom: 0;
	}
	.dot {
		position: absolute;
		z-index: 1;
		top: 0.35rem;
		left: calc(-2rem);
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: var(--rail);
		box-shadow: 0 0 0 4px transparent;
		transition:
			background 0.4s ease,
			box-shadow 0.4s ease,
			scale 0.4s cubic-bezier(0.3, 1.6, 0.5, 1);
	}
	/* Over the rail, the dot needs a solid ground; the page shows through the gap around it. */
	.is-reached .dot {
		background: var(--c);
		box-shadow: 0 0 0 4px color-mix(in srgb, var(--c) 20%, transparent);
		scale: 1.15;
	}
	.dot.fx-live {
		--fx-color: var(--c);
		width: 10px;
		height: 10px;
		vertical-align: baseline;
	}

	.date {
		display: block;
		margin-bottom: 0.35rem;
		color: var(--c);
		font-size: 0.875rem;
		font-weight: 700;
		font-variant-numeric: tabular-nums;
		opacity: 0.55;
		transition: opacity 0.4s ease;
	}
	h3 {
		margin: 0 0 0.35rem;
		font-size: 1.15rem;
	}
	p {
		margin: 0;
		line-height: 1.6;
		opacity: 0.7;
	}
	.is-reached .date {
		opacity: 1;
	}

	@media (prefers-reduced-motion: reduce) {
		.dot,
		.date {
			transition: none;
		}
	}
</style>
