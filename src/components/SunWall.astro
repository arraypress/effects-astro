---
/**
 * SunWall: low sunlight on a plaster wall, through venetian blinds (hard bars whose penumbra grows with the throw) or
 * with a prism's spectrum beside a patch of sun, creeping slowly. See src/runtime/sun-wall.js.
 *
 * Fills its nearest positioned ancestor, or the viewport with `fixed`. Opaque: it paints the wall everywhere; the
 * element shows a CSS still of it until the shader starts and without WebGL.
 *
 * @example
 * <section class="hero" style="position: relative">
 *   <SunWall mode="blinds" wall="#d8c3a5" />
 *   <h1>…</h1>
 * </section>
 */
import EffectCanvas from './EffectCanvas.astro';
import { sunWallStill, type SunWallConfig } from '../runtime/sun-wall.js';

interface Props extends SunWallConfig {
	/** Fill the viewport (position: fixed). Default false. */
	fixed?: boolean;
	/** Run only while near the screen (true, or how near as a CSS length), giving its WebGL context back when away. Default false. */
	lazy?: boolean | string;
	class?: string;
}

const { fixed = false, lazy = false, class: className, ...config } = Astro.props;
const still = sunWallStill(config);
---

<EffectCanvas name="sun-wall" config={config} fixed={fixed} lazy={lazy} background={still} class={className} />

<script>
	import { mount } from '../runtime/mount.js';
	import { sunWall } from '../runtime/sun-wall.js';

	mount('[data-effect-sun-wall]', sunWall);
</script>
