---
/**
 * Magnetic: an element the pointer pulls on. As the pointer comes near it
 * leans towards it, its contents a little further, and springs back when
 * the pointer goes: a call to action that feels like a soft object. See
 * src/runtime/magnetic.js. Still on touch screens and with reduced motion.
 *
 * @example
 * <Magnetic as="a" href="/start" class="button" strength={0.35}>Start selling</Magnetic>
 */
import type { HTMLTag } from 'astro/types';
import type { MagneticConfig } from '../runtime/magnetic.js';

interface Props extends MagneticConfig {
	/** The element to render. Default `span`. */
	as?: HTMLTag;
	class?: string;
	[attribute: string]: unknown;
}

const { as: Tag = 'span', strength, reach, class: className, ...attributes } = Astro.props;
---

<Tag class:list={['effect-magnetic', className]} data-effect-magnetic data-effect-config={JSON.stringify({ strength, reach })} {...attributes}>
	<span class="inner"><slot /></span>
</Tag>

<script>
	import { mount } from '../runtime/mount.js';
	import { magnetic } from '../runtime/magnetic.js';

	mount('[data-effect-magnetic]', magnetic);
</script>

<style>
	.effect-magnetic {
		display: inline-flex;
		translate: var(--magnet-x, 0px) var(--magnet-y, 0px);
		transition: translate 0.5s cubic-bezier(0.2, 0.9, 0.2, 1.2);
	}
	.inner {
		display: inherit;
		align-items: inherit;
		gap: inherit;
		translate: var(--magnet-inner-x, 0px) var(--magnet-inner-y, 0px);
		transition: translate 0.5s cubic-bezier(0.2, 0.9, 0.2, 1.2);
	}
	.effect-magnetic:global(.is-pulled),
	.effect-magnetic:global(.is-pulled) .inner {
		transition-duration: 0.15s;
	}
</style>
