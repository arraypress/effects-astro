---
/**
 * FlutedBokeh: coloured lights out of focus behind reeded glass (upright
 * flutes with a thin rainbow at each seam) or a wall of glass blocks, the
 * lights drifting slowly. No pointer, made to sit behind copy. See
 * src/runtime/fluted-bokeh.js.
 *
 * Fills its nearest positioned ancestor, or the viewport with `fixed`.
 * Opaque: it paints its `background` (default near-black) everywhere; the
 * element shows a CSS still of it until the shader starts and without WebGL.
 *
 * @example
 * <section class="hero" style="position: relative; background: #050608">
 *   <FlutedBokeh colors={['#ff4a2a', '#ffb347', '#4fc3ff']} mode="reeds" />
 *   <h1>…</h1>
 * </section>
 */
import EffectCanvas from './EffectCanvas.astro';
import { bokehStill, type FlutedBokehConfig } from '../runtime/fluted-bokeh.js';

interface Props extends FlutedBokehConfig {
	/** Fill the viewport (position: fixed). Default false. */
	fixed?: boolean;
	/** Run only while near the screen (true, or how near as a CSS length), giving its WebGL context back when away: for pages with many effects. Default false. */
	lazy?: boolean | string;
	class?: string;
}

const { fixed = false, lazy = false, class: className, ...config } = Astro.props;
const still = bokehStill(config);
---

<EffectCanvas name="fluted-bokeh" config={config} fixed={fixed} lazy={lazy} background={still} class={className} />

<script>
	import { mount } from '../runtime/mount.js';
	import { flutedBokeh } from '../runtime/fluted-bokeh.js';

	mount('[data-effect-fluted-bokeh]', flutedBokeh);
</script>
