---
/**
 * Caustics: sunlight through rippling water onto a pool floor, a bright,
 * shifting net of light over an aqua ground, with a faint rainbow at the
 * edges of its lines. The pointer stirs the water where it is; faint
 * tiles can lie on the floor. See src/runtime/caustics.js.
 *
 * Opaque: it is the whole background of what it fills (its nearest
 * positioned ancestor, or the viewport with `fixed`). Without WebGL the
 * floor shows, fading into `background`.
 *
 * @example
 * <section class="hero" style="position: relative">
 *   <Caustics tiles quiet={{ radius: 0.5 }} />
 *   <h1>The pool is <em>open.</em></h1>
 * </section>
 */
import EffectCanvas from './EffectCanvas.astro';
import { causticTones } from '../runtime/caustics.js';
import type { CausticsConfig } from '../runtime/caustics.js';

interface Props extends CausticsConfig {
	/** Fill the viewport, behind the page (position: fixed, z-index -1). Default false. */
	fixed?: boolean;
	class?: string;
}

const { fixed = false, class: className, ...config } = Astro.props;
const tones = causticTones(config);
---

<EffectCanvas name="caustics" config={config} fixed={fixed} class={className} behind background={`radial-gradient(ellipse at 50% 50%, ${tones.floor}, ${tones.deep} 70%, ${tones.background})`} />

<script>
	import { mount } from '../runtime/mount.js';
	import { caustics } from '../runtime/caustics.js';

	mount('[data-effect-caustics]', caustics);
</script>
