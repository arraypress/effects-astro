---
/**
 * FlowField: hundreds of short, fine trails riding a slowly evolving
 * noise flow, born, gathering into streams and fading, white on black by
 * default; how many there are, how fast they go and how heavy the lines
 * are drift slowly. See src/runtime/flow-field.js.
 *
 * Opaque: it fills its `background` every frame, so it is the whole
 * background of what it fills (its nearest positioned ancestor, or the
 * viewport with `fixed`). Canvas 2D, so it needs no WebGL; one settled
 * still frame with reduced motion. `setColors` recolours it live.
 *
 * @example
 * <section class="hero" style="position: relative">
 *   <FlowField colors={['#c8ff00', '#39ff88']} background="#0b0b0b" quiet={{ radius: 0.5, depth: 0.85 }} />
 *   <h1>…</h1>
 * </section>
 */
import EffectCanvas from './EffectCanvas.astro';
import type { FlowFieldConfig } from '../runtime/flow-field.js';

interface Props extends FlowFieldConfig {
	/** Fill the viewport, behind the page (position: fixed, z-index -1). Default false. */
	fixed?: boolean;
	class?: string;
}

const { fixed = false, class: className, ...config } = Astro.props;
---

<EffectCanvas name="flow-field" config={config} fixed={fixed} class={className} behind background={config.background ?? '#000000'} />

<script>
	import { mount } from '../runtime/mount.js';
	import { flowField } from '../runtime/flow-field.js';

	mount('[data-effect-flow-field]', flowField);
</script>
