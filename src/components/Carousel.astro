---
/**
 * Carousel: a row of cards that scrolls sideways. Touch, trackpads and
 * the keyboard scroll it natively; a mouse can drag it and throw it, and
 * it settles with each card aligned. Its edges fade where there is more
 * to see, and `buttons` adds back and next arrows. A drag across a card
 * does not count as a click on it. See src/runtime/carousel.js.
 *
 * Each child is one card; give them a width (`flex-basis` or `width`).
 *
 * @example
 * <Carousel label="Featured packs" buttons>
 *   {packs.map((pack) => <a class="card" href={pack.url}>…</a>)}
 * </Carousel>
 */

interface Props {
	/** Its accessible name. */
	label?: string;
	/** Space between cards, any CSS length. Default `1rem`. */
	gap?: string;
	/** How cards align when it settles, or `false` to scroll freely. Default `start`. */
	snap?: 'start' | 'center' | false;
	/** Width of the edge fades, px; 0 for none. Default 48. */
	fade?: number;
	/** Back and next arrow buttons. Default false. */
	buttons?: boolean;
	/** The buttons' labels. Default `Previous` and `Next`. */
	labels?: [string, string];
	class?: string;
}

const { label, gap = '1rem', snap = 'start', fade = 48, buttons = false, labels = ['Previous', 'Next'], class: className } = Astro.props;
---

<section
	class:list={['effect-carousel', className]}
	style={`--carousel-gap: ${gap}; --carousel-fade: ${fade}px; --carousel-snap: ${snap || 'none'}`}
	aria-label={label}
	aria-roledescription="carousel"
	data-effect-carousel
>
	<div class:list={['track', { snaps: snap }]} tabindex="0" data-carousel-track><slot /></div>
	{
		buttons && (
			<div class="buttons">
				<button type="button" data-carousel-prev aria-label={labels[0]} disabled>
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
				</button>
				<button type="button" data-carousel-next aria-label={labels[1]}>
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18l6-6-6-6" /></svg>
				</button>
			</div>
		)
	}
</section>

<script>
	import { mount } from '../runtime/mount.js';
	import { carousel } from '../runtime/carousel.js';

	mount('[data-effect-carousel]', carousel);
</script>

<style>
	@property --carousel-from {
		syntax: '<length>';
		initial-value: 0px;
		inherits: true;
	}
	@property --carousel-to {
		syntax: '<length>';
		initial-value: 0px;
		inherits: true;
	}

	.effect-carousel {
		--carousel-from: 0px;
		--carousel-to: 0px;
		position: relative;
		/* Its width comes from its container, never from its cards, so a grid or flex parent cannot grow to fit them. */
		contain: inline-size;
		transition:
			--carousel-from 0.3s ease,
			--carousel-to 0.3s ease;
	}
	.effect-carousel[data-start] {
		--carousel-from: var(--carousel-fade);
	}
	.effect-carousel[data-end] {
		--carousel-to: var(--carousel-fade);
	}

	.track {
		display: flex;
		gap: var(--carousel-gap);
		overflow-x: auto;
		overscroll-behavior-x: contain;
		scrollbar-width: none;
		cursor: grab;
		-webkit-mask-image: linear-gradient(90deg, transparent, #000 var(--carousel-from), #000 calc(100% - var(--carousel-to)), transparent);
		mask-image: linear-gradient(90deg, transparent, #000 var(--carousel-from), #000 calc(100% - var(--carousel-to)), transparent);
	}
	.track::-webkit-scrollbar {
		display: none;
	}
	.track:focus-visible {
		outline: 2px solid currentColor;
		outline-offset: -2px;
	}
	.snaps {
		scroll-snap-type: x mandatory;
	}
	.track > :global(*) {
		flex: none;
		scroll-snap-align: var(--carousel-snap);
	}
	[data-dragging] .track {
		cursor: grabbing;
		scroll-snap-type: none;
		user-select: none;
	}

	.buttons {
		display: flex;
		justify-content: flex-end;
		gap: 0.5rem;
		margin-top: 1rem;
	}
	button {
		display: grid;
		place-items: center;
		width: 2.5rem;
		height: 2.5rem;
		padding: 0;
		border: 1px solid color-mix(in srgb, currentColor 22%, transparent);
		border-radius: 999px;
		background: none;
		color: inherit;
		cursor: pointer;
		transition:
			opacity 0.2s ease,
			background 0.2s ease;
	}
	button:hover:not(:disabled) {
		background: color-mix(in srgb, currentColor 8%, transparent);
	}
	button:disabled {
		opacity: 0.3;
		cursor: default;
	}
	svg {
		width: 1.1rem;
		height: 1.1rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	@media (prefers-reduced-motion: reduce) {
		.effect-carousel {
			transition: none;
		}
	}
</style>
