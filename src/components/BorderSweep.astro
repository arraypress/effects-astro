---
/**
 * BorderSweep: a light travelling round an element's outline, on hover
 * and focus or (`always`) all the time. A wrapper for `class="sweep-ring"`
 * from border-sweep.css; for elements you render yourself, import
 * `@arraypress/effects-astro/border-sweep.css` and add the class.
 *
 * Suits outlined things: cards, ghost buttons, a featured pricing tier. A
 * filled button has no outline for the light to travel. `lights={2}` sends
 * two round, chasing each other; `inset` keeps the ring over the content of
 * a card that clips and fills itself.
 *
 * @example
 * <BorderSweep as="a" href="/pricing" class="card" color="#a5b4fc" always>…</BorderSweep>
 */
import type { HTMLTag } from 'astro/types';
import '../styles/border-sweep.css';
import { withStyle } from './style.js';

interface Props {
	/** The element to render. Default `div`. */
	as?: HTMLTag;
	/** The light's colour. Default the text colour. */
	color?: string;
	/** Seconds a lap takes. Default 2.6. */
	speed?: number;
	/** The ring's width, px. Default 1. */
	width?: number;
	/** Run all the time, not only on hover. Default false. */
	always?: boolean;
	/** How many lights go round, 1–2: two chase each other half a lap apart. Default 1. */
	lights?: 1 | 2;
	/** Draw the ring inside the edge and over the content, for elements that clip (`overflow: hidden`) and fill themselves with a picture or a canvas. Default false. */
	inset?: boolean;
	class?: string;
	[attribute: string]: unknown;
}

const { as: Tag = 'div', color, speed, width, always = false, lights = 1, inset = false, class: className, style: given, ...attributes } = Astro.props;
const style = [color && `--sweep-color: ${color}`, speed !== undefined && `--sweep-speed: ${speed}s`, width !== undefined && `--sweep-width: ${width}px`]
	.filter(Boolean)
	.join('; ');
---

<Tag class:list={['sweep-ring', { 'sweep-ring--always': always, 'sweep-ring--two': lights === 2, 'sweep-ring--inset': inset }, className]} style={withStyle(style, given)} {...attributes}><slot /></Tag>
