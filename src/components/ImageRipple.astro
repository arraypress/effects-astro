---
/**
 * ImageRipple: a photo under a skin of water. The pointer drags a wake
 * through it and a click drops a ring; the waves bend the photo, part its
 * colours a little at their fronts and catch the light on their crests,
 * then settle back to the still, sharp photo. See
 * src/runtime/image-ripple.js.
 *
 * A real `<img>` sits under the canvas, so the photo is there for screen
 * readers, before the script runs, and without WebGL or with reduced
 * motion. Fills its nearest positioned ancestor.
 *
 * @example
 * <section class="hero" style="position: relative">
 *   <ImageRipple src="/photos/lake.jpg" alt="A misty lake at dawn" />
 *   <h1>…</h1>
 * </section>
 */
import EffectCanvas from './EffectCanvas.astro';
import type { ImageRippleConfig } from '../runtime/image-ripple.js';

interface Props extends ImageRippleConfig {
	/** The photo's text alternative. Default empty: decoration. */
	alt?: string;
	class?: string;
}

const { alt = '', class: className, ...config } = Astro.props;
---

<div class:list={['image-ripple', className]}>
	<img class="image-ripple__photo" src={config.src} alt={alt} decoding="async" style={config.fit === 'contain' ? 'object-fit: contain' : undefined} />
	<EffectCanvas name="image-ripple" config={config} />
</div>

<style>
	.image-ripple {
		position: absolute;
		inset: 0;
		overflow: hidden;
	}
	.image-ripple__photo {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
</style>

<script>
	import { mount } from '../runtime/mount.js';
	import { imageRipple } from '../runtime/image-ripple.js';

	mount('[data-effect-image-ripple]', imageRipple);
</script>
