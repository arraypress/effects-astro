---
/**
 * FlutedGlow: a soft ring, orb or rising light seen through upright reeded
 * glass, breathing slowly, made to sit behind copy (no pointer). See
 * src/runtime/fluted-glow.js.
 *
 * Fills its nearest positioned ancestor, or the viewport with `fixed`.
 * Opaque: it paints its `background` (default near-black) everywhere; the
 * element shows a CSS still of it until the shader starts and without WebGL.
 *
 * @example
 * <section class="hero" style="position: relative; background: #0b0b0b">
 *   <FlutedGlow colors={['#7a1d00', '#ff7a00', '#ffd27a']} shape="ring" />
 *   <h1>…</h1>
 * </section>
 */
import EffectCanvas from './EffectCanvas.astro';
import { glowStill, type FlutedGlowConfig } from '../runtime/fluted-glow.js';

interface Props extends FlutedGlowConfig {
	/** Fill the viewport (position: fixed). Default false. */
	fixed?: boolean;
	/** Run only while near the screen (true, or how near as a CSS length), giving its WebGL context back when away: for pages with many effects. Default false. */
	lazy?: boolean | string;
	class?: string;
}

const { fixed = false, lazy = false, class: className, ...config } = Astro.props;
const still = glowStill(config);
---

<EffectCanvas name="fluted-glow" config={config} fixed={fixed} lazy={lazy} background={still} class={className} />

<script>
	import { mount } from '../runtime/mount.js';
	import { flutedGlow } from '../runtime/fluted-glow.js';

	mount('[data-effect-fluted-glow]', flutedGlow);
</script>
