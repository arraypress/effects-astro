---
/**
 * VoxelLogo: a logo or character built of cubes, rocking slowly in
 * perspective and turning towards the pointer, outlined where cubes meet
 * and dithered down to two inks. With `markers`, tracking markers ring it.
 * See src/runtime/voxel-logo.js.
 *
 * Opaque: it is the whole background of what it fills (its nearest
 * positioned ancestor, or the viewport with `fixed`). Without WebGL the
 * paper colour shows. Set `--effect-tracker-color` on it to colour any
 * markers (the ink colour suits).
 *
 * @example
 * <section class="cta" style="position: relative">
 *   <VoxelLogo text="✳" colors={['#a7f3d0', '#08090a']} />
 *   <h2>Your next release starts here.</h2>
 * </section>
 */
import EffectCanvas from './EffectCanvas.astro';
import type { VoxelLogoConfig } from '../runtime/voxel-logo.js';

interface Props extends VoxelLogoConfig {
	/** Fill the viewport, behind the page (position: fixed, z-index -1). Default false. */
	fixed?: boolean;
	class?: string;
}

const { fixed = false, class: className, ...config } = Astro.props;
---

<EffectCanvas
	name="voxel-logo"
	config={config}
	fixed={fixed}
	class={className}
	behind
	pixelated
	background={config.colors?.[1] ?? '#08090a'}
/>

<script>
	import { mount } from '../runtime/mount.js';
	import { voxelLogo } from '../runtime/voxel-logo.js';

	mount('[data-effect-voxel-logo]', voxelLogo);
</script>
